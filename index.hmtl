    function updateCloudSyncBadge(statusText, isOnline) {
      const badge = document.getElementById('firebase-sync-badge');
      if (!badge) return;
      badge.textContent = statusText;
      badge.className = isOnline
        ? 'px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/40 text-emerald-400'
        : 'px-2.5 py-0.5 rounded-full bg-acoustic border border-borderline text-ash';
    }

    function sanitizeDocId(raw) {
      return String(raw || 'item').toLowerCase().replace(/[^a-z0-9_-]/g, '_');
    }

    function prepareProjectForFirestore(proj) {
      const copy = { ...proj };
      const maxFieldLen = 650000;
      ['dpProofDataUrl', 'pelunasanProofDataUrl', 'previewAudioUrl', 'masterFileUrl'].forEach(key => {
        if (typeof copy[key] === 'string' && copy[key].length > maxFieldLen) {
          copy[key] = '';
        }
      });
      return copy;
    }

    async function uploadFileToFirebaseStorage(path, file) {
      if (!fbStorage || !firebaseUser || !file) return '';
      try {
        const sRef = storageRef(fbStorage, `artifacts/${firebaseAppId}/public/${path}`);
        await uploadBytes(sRef, file);
        return await getDownloadURL(sRef);
      } catch (_) {
        return '';
      }
    }

    async function initFirebaseSync() {
      try {
        const cfg = (typeof __firebase_config !== 'undefined' && __firebase_config)
          ? JSON.parse(__firebase_config)
          : STUDIO_FIREBASE_CONFIG;
        const fbApp = initializeApp(cfg);
        const fbAuth = getAuth(fbApp);
        db = getFirestore(fbApp);
        fbStorage = getStorage(fbApp);

        let authCred;
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          authCred = await signInWithCustomToken(fbAuth, __initial_auth_token);
        } else {
          authCred = await signInAnonymously(fbAuth);
        }
        firebaseUser = authCred?.user || fbAuth.currentUser;
        if (!firebaseUser) return;

        updateCloudSyncBadge('Cloud: Terhubung', true);

        const projCol = collection(db, 'artifacts', firebaseAppId, 'public', 'data', 'projects');
        onSnapshot(projCol, (snap) => {
          if (!snap.empty) {
            const cloudList = [];
            snap.forEach(d => cloudList.push(d.data()));
            const localMap = new Map(appState.projects.map(p => [p.id, p]));
            const merged = cloudList.map(cp => {
              const lp = localMap.get(cp.id);
              if (!lp) return cp;
              return {
                ...cp,
                dpProofDataUrl: cp.dpProofDataUrl || lp.dpProofDataUrl || '',
                pelunasanProofDataUrl: cp.pelunasanProofDataUrl || lp.pelunasanProofDataUrl || '',
                previewAudioUrl: cp.previewAudioUrl || lp.previewAudioUrl || '',
                masterFileUrl: cp.masterFileUrl || lp.masterFileUrl || ''
              };
            });
            merged.sort((a, b) => (b.createdTs || 0) - (a.createdTs || 0));
            appState.projects = merged;
            persistLocalState();
            if (appState.currentPage === 'client') renderClientWorkspace();
            if (appState.currentPage === 'admin' && appState.isAdminAuthenticated) renderAdminDashboard();
          }
        }, () => {
          updateCloudSyncBadge('Cloud: Mode Lokal', false);
        });

        const usersCol = collection(db, 'artifacts', firebaseAppId, 'public', 'data', 'users');
        onSnapshot(usersCol, (snap) => {
          if (!snap.empty) {
            const userMap = new Map(appState.users.map(u => [u.email, u]));
            snap.forEach(d => {
              const u = d.data();
              if (u && u.email) userMap.set(u.email, u);
            });
            appState.users = Array.from(userMap.values());
            persistLocalState();
          }
        }, () => {});

        const configDoc = doc(db, 'artifacts', firebaseAppId, 'public', 'data', 'studio_config', 'main');
        onSnapshot(configDoc, (docSnap) => {
          if (docSnap.exists()) {
            const data = docSnap.data();
            if (data.settings) appState.settings = { ...appState.settings, ...data.settings };
            if (Array.isArray(data.portfolioItems)) appState.portfolioItems = data.portfolioItems;
            persistLocalState();
            if (appState.currentPage === 'portfolio') renderPortfolioGrid();
          }
        }, () => {});
      } catch (_) {
        updateCloudSyncBadge('Cloud: Mode Lokal', false);
      }
    }

    async function syncProjectToCloud(proj) {
      persistLocalState();
      if (!db || !firebaseUser) return;
      try {
        const ref = doc(db, 'artifacts', firebaseAppId, 'public', 'data', 'projects', proj.id);
        await setDoc(ref, prepareProjectForFirestore(proj));
      } catch (_) {}
    }

    async function syncUserToCloud(userObj) {
      persistLocalState();
      if (!db || !firebaseUser || !userObj?.email) return;
      try {
        const ref = doc(db, 'artifacts', firebaseAppId, 'public', 'data', 'users', sanitizeDocId(userObj.email));
        await setDoc(ref, userObj);
      } catch (_) {}
    }

    async function syncStudioConfigToCloud() {
      persistLocalState();
      if (!db || !firebaseUser) return;
      try {
        const ref = doc(db, 'artifacts', firebaseAppId, 'public', 'data', 'studio_config', 'main');
        await setDoc(ref, {
          settings: appState.settings,
          portfolioItems: appState.portfolioItems
        });
      } catch (_) {}
    }

    // -------------------------------------------------------------------------
    // UTILITIES: TOAST, RUPIAH, TERBILANG, TEXT WRAP
    // -------------------------------------------------------------------------
    function showToast(title, message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const borderColor = type === 'error' ? 'border-l-red-500' : type === 'warning' ? 'border-l-amber-400' : 'border-l-emerald-400';
      const el = document.createElement('div');
      el.className = `pointer-events-auto bg-charcoal border border-borderline border-l-4 ${borderColor} rounded-xl p-3.5 shadow-2xl text-xs transition-all duration-200`;
      el.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <div>
            <strong class="text-ivory block">${title}</strong>
            <span class="text-ash block mt-0.5 leading-relaxed">${message}</span>
          </div>
          <button type="button" onclick="this.parentElement.parentElement.remove()" class="text-ash hover:text-ivory text-xs">✕</button>
        </div>
      `;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 250);
      }, 4200);
    }

    function formatRupiah(num) {
      return 'Rp' + Number(num || 0).toLocaleString('id-ID');
    }

    function numberToIndonesianWords(n) {
      n = Math.floor(Number(n) || 0);
      if (n === 0) return 'Nol';
      const satuan = ['', 'Satu', 'Dua', 'Tiga', 'Empat', 'Lima', 'Enam', 'Tujuh', 'Delapan', 'Sembilan', 'Sepuluh', 'Sebelas'];
      function convert(x) {
        if (x < 12) return satuan[x];
        if (x < 20) return convert(x - 10) + ' Belas';
        if (x < 100) return convert(Math.floor(x / 10)) + ' Puluh' + (x % 10 ? ' ' + convert(x % 10) : '');
        if (x < 200) return 'Seratus' + (x - 100 ? ' ' + convert(x - 100) : '');
        if (x < 1000) return convert(Math.floor(x / 100)) + ' Ratus' + (x % 100 ? ' ' + convert(x % 100) : '');
        if (x < 2000) return 'Seribu' + (x - 1000 ? ' ' + convert(x - 1000) : '');
        if (x < 1000000) return convert(Math.floor(x / 1000)) + ' Ribu' + (x % 1000 ? ' ' + convert(x % 1000) : '');
        if (x < 1000000000) return convert(Math.floor(x / 1000000)) + ' Juta' + (x % 1000000 ? ' ' + convert(x % 1000000) : '');
        return convert(Math.floor(x / 1000000000)) + ' Miliar' + (x % 1000000000 ? ' ' + convert(x % 1000000000) : '');
      }
      return convert(n).trim();
    }

    function wrapCanvasText(ctx, text, maxWidth) {
      const paragraphs = String(text || '').split('\n');
      const lines = [];
      paragraphs.forEach(p => {
        const words = p.split(' ');
        let current = '';
        words.forEach(word => {
          const test = current ? current + ' ' + word : word;
          if (ctx.measureText(test).width > maxWidth && current) {
            lines.push(current);
            current = word;
          } else {
            current = test;
          }
        });
        if (current) lines.push(current);
      });
      return lines;
    }

    function triggerPngFileDownload(dataUrl, filename) {
      const a = document.createElement('a');
      a.href = dataUrl;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }

    // -------------------------------------------------------------------------
    // NAVIGATION & HEADER AUTH STATUS
    // -------------------------------------------------------------------------
    function navigateTo(page) {
      appState.currentPage = page;
      document.querySelectorAll('.page-section').forEach(sec => sec.classList.add('hidden'));
      const target = document.getElementById(`page-${page}`);
      if (target) {
        target.classList.remove('hidden');
        target.classList.remove('page-dissolve');
        void target.offsetWidth;
        target.classList.add('page-dissolve');
      }

      document.querySelectorAll('.nav-pill').forEach(btn => {
        btn.classList.remove('bg-gold', 'text-obsidian');
        btn.classList.add('text-ash', 'hover:text-ivory');
      });
      const activeNav = document.getElementById(`nav-${page}`);
      if (activeNav) {
        activeNav.classList.add('bg-gold', 'text-obsidian');
        activeNav.classList.remove('text-ash', 'hover:text-ivory');
      }

      document.querySelectorAll('.mnav-pill').forEach(btn => {
        btn.classList.remove('bg-gold', 'text-obsidian');
        btn.classList.add('text-ash');
      });
      const activeMNav = document.getElementById(`mnav-${page}`);
      if (activeMNav) {
        activeMNav.classList.add('bg-gold', 'text-obsidian');
        activeMNav.classList.remove('text-ash');
      }

      const mobBar = document.getElementById('mobile-sticky-bar');
      if (mobBar) {
        if (page === 'order' && !document.getElementById('order-form-container')?.classList.contains('hidden')) {
          mobBar.classList.remove('hidden');
        } else {
          mobBar.classList.add('hidden');
        }
      }

      if (page === 'portfolio') renderPortfolioGrid();
      if (page === 'order') refreshOrderPageUI();
      if (page === 'client') refreshClientPageUI();
      if (page === 'admin') refreshAdminPageUI();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function updateHeaderAuthBadge() {
      const box = document.getElementById('header-auth-status');
      if (!box) return;
      if (appState.currentClientUser) {
        box.innerHTML = `
          <div class="flex items-center gap-1.5 bg-charcoal border border-borderline rounded-xl px-2.5 py-1.5 text-[11px]">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            <span class="font-semibold text-ivory max-w-[90px] truncate">${appState.currentClientUser.name}</span>
            <button type="button" onclick="logoutClientUser()" class="text-ash hover:text-red-400 ml-1" title="Keluar">✕</button>
          </div>
        `;
      } else {
        box.innerHTML = `
          <button type="button" onclick="openClientAuthModal('register')" class="px-3 py-2 rounded-xl bg-charcoal border border-borderline hover:border-gold text-xs font-semibold text-ivory transition">
            Daftar / Masuk
          </button>
        `;
      }
    }

    function selectServiceAndGoOrder(svcKey) {
      appState.selectedServiceLine = svcKey;
      appState.selectedPackage = 'standar';
      navigateTo('order');
    }

    function renderSop14Grid() {
      const grid = document.getElementById('sop-14-grid');
      if (!grid) return;
      grid.innerHTML = SOP_14_STEPS.map(s => `
        <div class="bg-charcoal border border-borderline rounded-xl p-4 space-y-1.5">
          <span class="text-[11px] font-mono font-bold text-gold">Tahap ${s.no}</span>
          <h4 class="text-xs sm:text-sm font-bold text-ivory">${s.title}</h4>
          <p class="text-[11px] text-ash leading-relaxed">${s.desc}</p>
        </div>
      `).join('');
    }

