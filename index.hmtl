```html
<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PrangArt Lab — Produksi Musik Tari, Non-Tari &amp; Transkripsi Musik</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            obsidian: '#09090b',
            charcoal: '#121215',
            acoustic: '#1a1a1f',
            gold: '#d4af37',
            goldhover: '#e6c34d',
            ivory: '#f4f4f5',
            ash: '#a1a1aa',
            borderline: '#27272a'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    };
  </script>
  <style>
    * { box-sizing: border-box; }
    html, body {
      background-color: #09090b;
      color: #f4f4f5;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #09090b; }
    ::-webkit-scrollbar-thumb { background: #27272a; border-radius: 9999px; }
    ::-webkit-scrollbar-thumb:hover { background: #d4af37; }
    .btn-gold {
      background: linear-gradient(135deg, #d4af37 0%, #c59b27 100%);
      color: #09090b;
      transition: all 0.2s ease;
    }
    .btn-gold:hover:not(:disabled) {
      background: linear-gradient(135deg, #e6c34d 0%, #d4af37 100%);
      box-shadow: 0 6px 20px rgba(212, 175, 55, 0.25);
      transform: translateY(-1px);
    }
    .btn-gold:disabled { opacity: 0.45; cursor: not-allowed; }
    .btn-ghost-gold {
      border: 1px solid rgba(212, 175, 55, 0.45);
      color: #d4af37;
      background: rgba(212, 175, 55, 0.04);
      transition: all 0.2s ease;
    }
    .btn-ghost-gold:hover {
      background: rgba(212, 175, 55, 0.14);
      border-color: #d4af37;
    }
    .page-dissolve { animation: pageDissolve 0.25s ease-out forwards; }
    @keyframes pageDissolve {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .shake-error { animation: shakeX 0.32s ease-in-out; }
    @keyframes shakeX {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-5px); }
      75% { transform: translateX(5px); }
    }
    @media print {
      body * { visibility: hidden; }
      #official-doc-canvas, #official-doc-canvas *,
      #contract-doc-canvas, #contract-doc-canvas * { visibility: visible; }
      #official-doc-canvas, #contract-doc-canvas {
        position: fixed; left: 0; top: 0; width: 100%; box-shadow: none !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col bg-obsidian text-ivory selection:bg-gold selection:text-obsidian">

  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toast-container" class="fixed top-4 right-4 z-[90] flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

  <!-- STICKY TOP HEADER -->
  <header class="sticky top-0 z-40 bg-obsidian/90 backdrop-blur-md border-b border-borderline">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
      <!-- Brand Logo -->
      <button type="button" onclick="navigateTo('home')" class="flex items-center gap-3 text-left group shrink-0">
        <div class="w-10 h-10 rounded-full bg-charcoal border border-gold/50 p-1 flex items-center justify-center overflow-hidden shadow-sm group-hover:border-gold transition">
          <img
            src="https://iili.io/o9B6HXa.md.png"
            alt="Logo PrangArt Lab"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            class="w-full h-full object-contain rounded-full"
          />
          <span class="hidden w-full h-full items-center justify-center font-bold text-gold text-xs">PA</span>
        </div>
        <div>
          <span class="font-extrabold text-base tracking-tight text-ivory block leading-none">PrangArt <span class="text-gold">Lab</span></span>
          <span class="text-[10px] font-mono uppercase tracking-widest text-ash block mt-1">Music Production Studio</span>
        </div>
      </button>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-1 bg-charcoal border border-borderline rounded-xl p-1">
        <button type="button" id="nav-home" onclick="navigateTo('home')" class="nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">Beranda &amp; Alur</button>
        <button type="button" id="nav-portfolio" onclick="navigateTo('portfolio')" class="nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">Portofolio</button>
        <button type="button" id="nav-order" onclick="navigateTo('order')" class="nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">Formulir Kebutuhan</button>
        <button type="button" id="nav-client" onclick="navigateTo('client')" class="nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">Ruang Klien</button>
        <button type="button" id="nav-admin" onclick="navigateTo('admin')" class="nav-pill px-3.5 py-1.5 rounded-lg text-xs font-semibold transition">Admin</button>
      </nav>

      <!-- Header Actions -->
      <div class="flex items-center gap-2">
        <div id="header-auth-status"></div>
        <button type="button" onclick="openProducerWaModal()" class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 shrink-0">
          <span>💬</span>
          <span class="hidden sm:inline">Diskusi WA</span>
          <span class="sm:hidden">WA</span>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Bar -->
    <div class="md:hidden border-t border-borderline bg-charcoal/95 px-2 py-1.5 flex items-center justify-around gap-1 overflow-x-auto">
      <button type="button" id="mnav-home" onclick="navigateTo('home')" class="mnav-pill px-2.5 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap">Beranda</button>
      <button type="button" id="mnav-portfolio" onclick="navigateTo('portfolio')" class="mnav-pill px-2.5 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap">Portofolio</button>
      <button type="button" id="mnav-order" onclick="navigateTo('order')" class="mnav-pill px-2.5 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap">Formulir</button>
      <button type="button" id="mnav-client" onclick="navigateTo('client')" class="mnav-pill px-2.5 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap">Klien</button>
      <button type="button" id="mnav-admin" onclick="navigateTo('admin')" class="mnav-pill px-2.5 py-1.5 rounded-lg text-[11px] font-semibold whitespace-nowrap">Admin</button>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="flex-1">

    <!-- =================================================================== -->
    <!-- PAGE 1: HOME, DISCUSSION MATRIX & COMPLETE 14-STEP SOP              -->
    <!-- =================================================================== -->
    <section id="page-home" class="page-section page-dissolve">
      <!-- Hero Section -->
      <div class="relative border-b border-borderline bg-gradient-to-b from-charcoal via-obsidian to-obsidian">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 space-y-5">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-charcoal border border-gold/30 text-gold text-xs font-mono">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>PrangArt Lab • Produksi Musik Tari, Non-Tari &amp; Transkripsi</span>
              </div>
              <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-ivory leading-[1.15]">
                Diskusi Jelas di Awal, <span class="text-gold">Hasil Musik Presisi</span>
              </h1>
              <p class="text-sm sm:text-base text-ash leading-relaxed max-w-2xl">
                PrangArt Lab menempatkan sesi diskusi kebutuhan sebagai tahap awal sebelum penawaran harga dan pembayaran. Konsultasikan konsep karya Anda terlebih dahulu, lalu dokumentasikan melalui formulir terstruktur.
              </p>
              <div class="flex flex-wrap items-center gap-3 pt-1">
                <button type="button" onclick="openProducerWaModal('Diskusi awal kebutuhan karya sebelum pemesanan')" class="btn-gold px-6 py-3.5 rounded-xl text-xs sm:text-sm font-bold flex items-center gap-2">
                  <span>💬 Jalur A: Diskusi via WhatsApp Dulu</span>
                </button>
                <button type="button" onclick="navigateTo('order')" class="btn-ghost-gold px-6 py-3.5 rounded-xl text-xs sm:text-sm font-bold">
                  Jalur B: Isi Formulir Kebutuhan →
                </button>
              </div>
              <p class="text-[11px] text-ash">
                *Catatan: Diskusi awal &amp; pengisian formulir kebutuhan tidak langsung mengikat atau mewajibkan pembayaran. Pembayaran dilakukan setelah penawaran &amp; persetujuan administrasi.
              </p>
            </div>

            <!-- Two Entry Paths Card -->
            <div class="lg:col-span-5 bg-charcoal border border-gold/40 rounded-2xl p-5 sm:p-6 space-y-4">
              <span class="text-[11px] font-mono uppercase tracking-wider text-gold font-bold block">2 Jalur Masuk Klien</span>
              <div class="space-y-3 text-xs">
                <div class="bg-acoustic border border-borderline rounded-xl p-3.5">
                  <strong class="text-gold block">Jalur A — Klien Melalui WhatsApp (Disarankan)</strong>
                  <p class="text-ash mt-1">1. Kontak awal → 2. Diskusi kebutuhan → 3. Isi formulir pemesanan</p>
                </div>
                <div class="bg-acoustic border border-borderline rounded-xl p-3.5">
                  <strong class="text-ivory block">Jalur B — Klien Melalui Website</strong>
                  <p class="text-ash mt-1">1. Akses website → 2. Isi formulir pengajuan kebutuhan → 3. Diskusi &amp; konsultasi</p>
                </div>
                <div class="bg-obsidian border border-gold/30 rounded-xl p-3 text-center">
                  <span class="text-[11px] font-mono text-emerald-400 font-semibold">Keduanya bertemu di tahap yang sama:</span>
                  <p class="text-xs font-bold text-ivory mt-0.5">Pemeriksaan → Penawaran → Persetujuan → Pembayaran</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 3 Service Pillars -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Layanan Studio</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-ivory mt-1">3 Kategori Layanan PrangArt Lab</h2>
          </div>
          <p class="text-xs text-ash">Estimasi paket referensi sebelum penawaran resmi.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Pillar 1: Produksi Musik Tari -->
          <div class="bg-charcoal border border-gold/50 rounded-2xl p-6 flex flex-col justify-between relative shadow-lg">
            <span class="absolute -top-3 right-5 bg-gold text-obsidian text-[10px] font-extrabold uppercase tracking-wider px-2.5 py-0.5 rounded-full">Layanan Utama</span>
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-xl bg-gold/15 border border-gold/40 flex items-center justify-center text-gold font-bold text-lg">🥁</span>
                <span class="text-xs font-mono text-gold font-bold bg-gold/10 px-2.5 py-1 rounded-lg">Mulai Rp1.000.000</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-ivory">Produksi Musik Tari</h3>
                <p class="text-xs text-ash mt-1 leading-relaxed">Komposisi, aransemen, mixing, dan mastering musik iringan tari tradisi, kreasi baru, maupun kontemporer.</p>
              </div>
              <ul class="space-y-1.5 text-xs text-ivory/90 border-t border-borderline pt-3.5">
                <li>• Paket Dasar (1jt • 3x revisi ringan)</li>
                <li>• Paket Standar (1,5jt • struktur &amp; timestamp • 6x revisi)</li>
                <li>• Paket Pro (2jt • alur kompleks • bebas revisi)</li>
                <li>• Persetujuan via <strong>Perjanjian Produksi Musik</strong></li>
              </ul>
            </div>
            <button type="button" onclick="selectServiceAndGoOrder('tari')" class="btn-gold w-full py-2.5 rounded-xl text-xs font-bold mt-6">
              Ajukan Produksi Musik Tari →
            </button>
          </div>

          <!-- Pillar 2: Produksi Musik Non-Tari -->
          <div class="bg-charcoal border border-borderline hover:border-gold/50 rounded-2xl p-6 flex flex-col justify-between transition">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-xl bg-acoustic border border-gold/30 flex items-center justify-center text-gold font-bold text-lg">🎛️</span>
                <span class="text-xs font-mono text-gold font-bold bg-gold/10 px-2.5 py-1 rounded-lg">Mulai Rp750.000</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-ivory">Produksi Musik Non-Tari</h3>
                <p class="text-xs text-ash mt-1 leading-relaxed">Aransemen lagu orisinal, musik ilustrasi teater/film, jingle instansi, dan produksi audio digital.</p>
              </div>
              <ul class="space-y-1.5 text-xs text-ivory/90 border-t border-borderline pt-3.5">
                <li>• Paket Dasar (750rb), Standar (1,2jt), Pro (1,8jt)</li>
                <li>• Opsi rekaman vokal soloist (+Rp50.000)</li>
                <li>• Sudah termasuk pengalihan hak ekonomi (Pasal 3)</li>
                <li>• Persetujuan via <strong>Perjanjian Produksi Musik</strong></li>
              </ul>
            </div>
            <button type="button" onclick="selectServiceAndGoOrder('digital')" class="btn-ghost-gold w-full py-2.5 rounded-xl text-xs font-bold mt-6">
              Ajukan Musik Non-Tari →
            </button>
          </div>

          <!-- Pillar 3: Transkripsi Musik -->
          <div class="bg-charcoal border border-borderline hover:border-gold/50 rounded-2xl p-6 flex flex-col justify-between transition">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-10 h-10 rounded-xl bg-acoustic border border-gold/30 flex items-center justify-center text-gold font-bold text-lg">🎼</span>
                <span class="text-xs font-mono text-gold font-bold bg-gold/10 px-2.5 py-1 rounded-lg">Mulai Rp350.000</span>
              </div>
              <div>
                <h3 class="text-lg font-bold text-ivory">Transkripsi Musik</h3>
                <p class="text-xs text-ash mt-1 leading-relaxed">Penulisan ulang sumber audio/video menjadi partitur rapi dalam format Not Angka, Not Balok, atau keduanya.</p>
              </div>
              <ul class="space-y-1.5 text-xs text-ivory/90 border-t border-borderline pt-3.5">
                <li>• Paket Dasar (350rb), Standar (600rb), Pro (1jt)</li>
                <li>• Melodi tunggal hingga skor ansambel lengkap</li>
                <li>• Format PDF siap cetak + audio panduan</li>
                <li>• Persetujuan penawaran &amp; ketentuan layanan</li>
              </ul>
            </div>
            <button type="button" onclick="selectServiceAndGoOrder('transkripsi')" class="btn-ghost-gold w-full py-2.5 rounded-xl text-xs font-bold mt-6">
              Ajukan Transkripsi Musik →
            </button>
          </div>
        </div>
      </div>

      <!-- DISCUSSION MATRIX & 7 CLARITY POINTS -->
      <div class="border-y border-borderline bg-charcoal/40">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-10">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Panduan Sesi Konsultasi</span>
            <h2 class="text-2xl font-bold text-ivory">Materi Diskusi per Layanan &amp; Poin Kesepakatan</h2>
            <p class="text-xs text-ash">Diskusi dilakukan via WhatsApp atau pertemuan daring (dapat lebih dari satu kali untuk karya kompleks).</p>
          </div>

          <!-- 3-Column Discussion Matrix -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
            <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-3">
              <h3 class="text-sm font-bold text-gold border-b border-borderline pb-2.5">1. Produksi Musik Tari</h3>
              <ul class="space-y-2 text-xs text-ivory/90">
                <li>• Konsep dan karakter tari</li>
                <li>• Alur dan struktur tari</li>
                <li>• Referensi musik</li>
                <li>• Durasi dan tempo</li>
                <li>• Kebutuhan produksi</li>
              </ul>
            </div>
            <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-3">
              <h3 class="text-sm font-bold text-gold border-b border-borderline pb-2.5">2. Produksi Musik Non-Tari</h3>
              <ul class="space-y-2 text-xs text-ivory/90">
                <li>• Konsep dan genre musik</li>
                <li>• Karakter dan suasana</li>
                <li>• Instrumen dan vokal</li>
                <li>• Durasi dan tempo</li>
                <li>• Kebutuhan rekaman</li>
              </ul>
            </div>
            <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-3">
              <h3 class="text-sm font-bold text-gold border-b border-borderline pb-2.5">3. Transkripsi Musik</h3>
              <ul class="space-y-2 text-xs text-ivory/90">
                <li>• Jenis notasi (Angka / Balok)</li>
                <li>• Sumber audio / video</li>
                <li>• Instrumen yang ditranskripsikan</li>
                <li>• Tingkat detail notasi</li>
                <li>• Format hasil akhir</li>
              </ul>
            </div>
          </div>

          <!-- 7 Clarity Points -->
          <div class="bg-charcoal border border-gold/30 rounded-2xl p-5 sm:p-6 space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-sm sm:text-base font-bold text-ivory">7 Hal yang Dipastikan Sebelum Sesi Diskusi Selesai:</h3>
              <button type="button" onclick="openProducerWaModal('Saya ingin menjadwalkan diskusi kebutuhan karya')" class="btn-gold px-4 py-2 rounded-xl text-xs font-bold">
                💬 Mulai Diskusi Sekarang
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-xs text-ivory/90">
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">1. Apa yang sebenarnya ingin dibuat/dikerjakan klien</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">2. Ruang lingkup pekerjaan yang termasuk layanan</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">3. Karakter dan spesifikasi hasil yang diinginkan</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">4. Perkiraan durasi karya &amp; waktu penyelesaian</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">5. Besaran biaya &amp; skema pembayaran (DP 50% / Penuh)</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline">6. Ketentuan kuota revisi dan penyerahan hasil</div>
              <div class="bg-acoustic rounded-xl p-3 border border-borderline sm:col-span-2">7. Pengaturan kredit komposer &amp; hak cipta (khusus produksi musik)</div>
            </div>
          </div>
        </div>
      </div>

      <!-- COMPLETE 14-STEP SOP TIMELINE -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 space-y-8">
        <div>
          <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Standar Operasional Studio</span>
          <h2 class="text-2xl font-bold text-ivory mt-1">Alur Pemesanan Lengkap PrangArt Lab (14 Tahap)</h2>
        </div>
        <div id="sop-14-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5"></div>
      </div>

      <!-- FAQ Section -->
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 space-y-6">
        <div class="text-center">
          <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Informasi Umum</span>
          <h2 class="text-2xl font-bold text-ivory mt-1">Pertanyaan yang Sering Diajukan</h2>
        </div>
        <div id="faq-accordion-list" class="space-y-3"></div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- PAGE 2: PORTFOLIO & SAMPLE PLAYER                                   -->
    <!-- =================================================================== -->
    <section id="page-portfolio" class="page-section hidden page-dissolve">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-borderline pb-6">
          <div>
            <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Arsip Karya</span>
            <h2 class="text-2xl sm:text-3xl font-bold text-ivory mt-1">Portofolio PrangArt Lab</h2>
            <p class="text-xs text-ash mt-1">Cuplikan produksi musik tari, musik non-tari, dan transkripsi partitur.</p>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="filterPortfolio('Semua')" class="pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-gold text-obsidian">Semua</button>
            <button type="button" onclick="filterPortfolio('Produksi Musik Tari')" class="pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-charcoal text-ash border border-borderline">Produksi Musik Tari</button>
            <button type="button" onclick="filterPortfolio('Produksi Musik Non-Tari')" class="pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-charcoal text-ash border border-borderline">Produksi Musik Non-Tari</button>
            <button type="button" onclick="filterPortfolio('Transkripsi Musik')" class="pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-charcoal text-ash border border-borderline">Transkripsi Musik</button>
          </div>
        </div>
        <div id="portfolio-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- PAGE 3: REQUIREMENT & ORDER BRIEF FORM (NO PAYMENT UPFRONT)         -->
    <!-- =================================================================== -->
    <section id="page-order" class="page-section hidden page-dissolve">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 pb-28 lg:pb-14">
        <div id="order-form-container">
          <!-- Top Banner: Client Account & WA Reminder -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-charcoal border border-borderline rounded-2xl p-4 sm:p-5 mb-6">
            <div id="order-account-banner" class="text-xs text-ivory"></div>
            <button type="button" onclick="openProducerWaModal('Konsultasi kebutuhan karya sebelum/saat mengisi formulir')" class="btn-ghost-gold px-4 py-2 rounded-xl text-xs font-bold shrink-0">
              💬 Diskusi Dulu via WhatsApp
            </button>
          </div>

          <!-- ENTRY PATH SELECTOR (JALUR A vs JALUR B) -->
          <div class="bg-charcoal border border-gold/40 rounded-2xl p-5 mb-6 space-y-3">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <span class="text-[10px] font-mono uppercase tracking-wider text-gold font-bold block">Tahap 2 &amp; 3 • Jalur Pengajuan</span>
                <h3 class="text-base font-bold text-ivory">Apakah Anda Sudah Melakukan Diskusi Awal dengan Produser?</h3>
              </div>
              <button type="button" onclick="openDraftContractPreviewModal()" class="px-3 py-1.5 rounded-lg bg-acoustic border border-gold/40 text-gold text-[11px] font-semibold hover:border-gold">
                📜 Lihat Ketentuan Layanan
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="flex items-start gap-3 p-3.5 rounded-xl bg-acoustic border border-borderline hover:border-gold cursor-pointer">
                <input type="radio" name="entry-path" value="Jalur A (Sudah Diskusi WA)" checked class="mt-0.5 accent-[#d4af37]" />
                <div class="text-xs">
                  <strong class="text-gold block">Jalur A — Sudah Diskusi Awal via WhatsApp</strong>
                  <span class="text-ash">Formulir ini mendokumentasikan hasil diskusi untuk pemeriksaan &amp; penerbitan penawaran resmi.</span>
                </div>
              </label>
              <label class="flex items-start gap-3 p-3.5 rounded-xl bg-acoustic border border-borderline hover:border-gold cursor-pointer">
                <input type="radio" name="entry-path" value="Jalur B (Ajukan Form Dulu)" class="mt-0.5 accent-[#d4af37]" />
                <div class="text-xs">
                  <strong class="text-ivory block">Jalur B — Ajukan Kebutuhan Dulu via Website</strong>
                  <span class="text-ash">Isi spesifikasi awal di bawah; Produser akan memeriksa materi dan mengajak diskusi sebelum penawaran harga.</span>
                </div>
              </label>
            </div>
          </div>

          <form id="prangart-order-form" onsubmit="handleOrderFormSubmit(event)" class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <!-- LEFT COLUMN: 8 COLS -->
            <div class="lg:col-span-8 space-y-6">

              <!-- STEP 1: PILIH LAYANAN & PAKET REFERENSI -->
              <div class="bg-charcoal border border-borderline rounded-2xl p-5 sm:p-6 space-y-4">
                <div>
                  <span class="text-[11px] font-mono text-gold font-bold uppercase">Bagian 1</span>
                  <h3 class="text-lg font-bold text-ivory">Pilih Layanan &amp; Paket Referensi</h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                  <button type="button" id="svc-tab-tari" onclick="selectServiceLine('tari')" class="svc-tab-btn p-3 rounded-xl border text-left transition">
                    <span class="text-xs font-bold block">🥁 Produksi Musik Tari</span>
                    <span class="text-[11px] opacity-80 block mt-0.5">Mulai Rp1.000.000</span>
                  </button>
                  <button type="button" id="svc-tab-digital" onclick="selectServiceLine('digital')" class="svc-tab-btn p-3 rounded-xl border text-left transition">
                    <span class="text-xs font-bold block">🎛️ Produksi Musik Non-Tari</span>
                    <span class="text-[11px] opacity-80 block mt-0.5">Mulai Rp750.000</span>
                  </button>
                  <button type="button" id="svc-tab-transkripsi" onclick="selectServiceLine('transkripsi')" class="svc-tab-btn p-3 rounded-xl border text-left transition">
                    <span class="text-xs font-bold block">🎼 Transkripsi Musik</span>
                    <span class="text-[11px] opacity-80 block mt-0.5">Mulai Rp350.000</span>
                  </button>
                </div>

                <div id="package-cards-grid" class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1"></div>
              </div>

              <!-- STEP 2: INFORMASI PEMESAN & IDENTITAS KARYA -->
              <div class="bg-charcoal border border-borderline rounded-2xl p-5 sm:p-6 space-y-5">
                <div>
                  <span class="text-[11px] font-mono text-gold font-bold uppercase">Bagian 2</span>
                  <h3 class="text-lg font-bold text-ivory">Informasi Pemesan &amp; Identitas Karya</h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Nama Lengkap Pemesan *</label>
                    <input type="text" id="field-nama" required placeholder="Contoh: Siti Rahmawati" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Email Aktif *</label>
                    <input type="email" id="field-email" required placeholder="nama@sanggar.id" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Nomor WhatsApp Aktif *</label>
                    <input type="tel" id="field-wa" required placeholder="081234567890" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Asal Pemesan (Kota / Daerah) *</label>
                    <input type="text" id="field-kota" required placeholder="Contoh: Samarinda, Kalimantan Timur" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Alamat Lengkap Pemesan (Untuk Perjanjian) *</label>
                    <input type="text" id="field-alamat" required placeholder="Contoh: Jl. Pahlawan No. 12, Samarinda" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Nomor Identitas / NIK (Opsional)</label>
                    <input type="text" id="field-nik" placeholder="NIK KTP (dapat dilengkapi saat perjanjian)" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs font-mono text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Nama Sanggar / Komunitas / Instansi / Individu *</label>
                    <input type="text" id="field-instansi" required placeholder="Contoh: Sanggar Pesona Mahakam" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Nama Koreografer / Pencipta Karya *</label>
                    <input type="text" id="field-koreografer" required placeholder="Contoh: Rina Puspitasari, S.Sn" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Judul / Nama Karya *</label>
                    <input type="text" id="field-judul" required placeholder="Contoh: Gema Enggang Mahakam" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Jenis Tari / Kategori Karya *</label>
                    <input type="text" id="field-jenis-tari" required placeholder="Contoh: Tari Kreasi Tradisi / Lagu Orisinal" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Latar Budaya / Konsep Utama *</label>
                    <input type="text" id="field-budaya" required placeholder="Contoh: Etnis Dayak Kenyah &amp; Pesisir Kutai" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  </div>
                  <div>
                    <label class="block text-xs font-semibold text-ivory mb-1.5">Estimasi Durasi (MM:SS) *</label>
                    <input type="text" id="field-durasi" required placeholder="05:30" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs font-mono text-ivory focus:outline-none" />
                  </div>
                </div>

                <div>
                  <label class="block text-xs font-semibold text-ivory mb-1.5">Link Google Drive / YouTube Materi &amp; Referensi *</label>
                  <input type="url" id="field-referensi" required placeholder="https://drive.google.com/drive/folders/..." class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
                  <p class="text-[11px] text-ash mt-1">Atur akses Google Drive ke <strong>"Siapa saja yang memiliki link (Viewer)"</strong> agar dapat diperiksa studio.</p>
                </div>

                <!-- Sinopsis with AI Assistant -->
                <div>
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                    <label class="block text-xs font-semibold text-ivory">Sinopsis / Konsep Karya *</label>
                    <button type="button" id="btn-ai-synopsis" onclick="generateAISynopsis()" class="px-3 py-1 rounded-lg bg-gold/15 border border-gold/40 text-gold text-[11px] font-bold hover:bg-gold/25 transition">
                      ✨ Generate Sinopsis AI
                    </button>
                  </div>
                  <textarea id="field-sinopsis" rows="4" required placeholder="Tuliskan konsep, karakter karya, alur suasana, dan hasil akhir yang diharapkan..." class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory leading-relaxed focus:outline-none"></textarea>
                  <div id="ai-synopsis-toolbar" class="hidden flex-wrap items-center justify-between gap-2 mt-2 p-2.5 rounded-xl bg-acoustic border border-gold/30 text-[11px]">
                    <span class="text-gold font-semibold">✨ Draf sinopsis AI diterapkan.</span>
                    <div class="flex items-center gap-2">
                      <button type="button" onclick="generateAISynopsis(true)" class="text-ivory underline hover:text-gold">Variasi Lain</button>
                      <button type="button" id="btn-ai-restore" onclick="restorePreviousSynopsis()" class="text-ash underline hover:text-ivory">Kembalikan Teks Lama</button>
                    </div>
                  </div>
                </div>
              </div>

              <!-- STEP 3: SPESIFIKASI MUSIKAL DINAMIS -->
              <div class="bg-charcoal border border-borderline rounded-2xl p-5 sm:p-6 space-y-5">
                <div>
                  <span class="text-[11px] font-mono text-gold font-bold uppercase">Bagian 3</span>
                  <h3 class="text-lg font-bold text-ivory">Uraian Spesifikasi Teknis &amp; Musikal</h3>
                </div>

                <div id="dynamic-spec-fields" class="space-y-4"></div>

                <!-- Add-ons -->
                <div id="addon-vocal-wrapper" class="pt-3 border-t border-borderline space-y-2.5">
                  <label class="flex items-center justify-between gap-3 p-3.5 rounded-xl bg-acoustic border border-borderline hover:border-gold/50 cursor-pointer">
                    <div>
                      <span class="text-xs font-bold text-ivory block">Penambahan Vokal / Sinden / Partitur Lengkap</span>
                      <span class="text-[11px] text-ash">Rekaman vokal live studio atau tambahan partitur lengkap.</span>
                    </div>
                    <div class="flex items-center gap-2.5 shrink-0">
                      <span id="addon-vocal-price-label" class="text-xs font-mono font-bold text-gold">+Rp50.000</span>
                      <input type="checkbox" id="field-addon-vocal" onchange="recalculateLivePrice()" class="w-4 h-4 accent-[#d4af37] rounded" />
                    </div>
                  </label>

                  <div class="p-3.5 rounded-xl bg-obsidian border border-gold/30 text-[11px] text-ash leading-relaxed">
                    <strong class="text-gold">✓ Pengalihan Hak Ekonomi Otomatis (Pasal 3):</strong> Harga produksi sudah termasuk pengalihan hak ekonomi kepada Pihak Kedua setelah pelunasan dan penyerahan file final tanpa biaya tambahan.
                  </div>
                </div>
              </div>

              <!-- STEP 4: RENCANA SKEMA PEMBAYARAN & KONFIRMASI PENGAJUAN -->
              <div class="bg-charcoal border border-borderline rounded-2xl p-5 sm:p-6 space-y-4">
                <div>
                  <span class="text-[11px] font-mono text-gold font-bold uppercase">Bagian 4</span>
                  <h3 class="text-lg font-bold text-ivory">Rencana Skema Pembayaran &amp; Kirim Pengajuan</h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <label class="flex items-start gap-2.5 p-3.5 rounded-xl bg-acoustic border border-borderline hover:border-gold cursor-pointer">
                    <input type="radio" name="payment-plan" value="DP 50%" checked onchange="recalculateLivePrice()" class="mt-0.5 accent-[#d4af37]" />
                    <div class="text-xs">
                      <strong class="text-ivory block">Skema DP 50% + Pelunasan 50%</strong>
                      <span class="text-ash">DP dibayar setelah Penawaran &amp; Persetujuan Administrasi.</span>
                    </div>
                  </label>
                  <label class="flex items-start gap-2.5 p-3.5 rounded-xl bg-acoustic border border-borderline hover:border-gold cursor-pointer">
                    <input type="radio" name="payment-plan" value="Pembayaran Penuh 100%" onchange="recalculateLivePrice()" class="mt-0.5 accent-[#d4af37]" />
                    <div class="text-xs">
                      <strong class="text-ivory block">Skema Pembayaran Penuh 100%</strong>
                      <span class="text-ash">Dibayarkan penuh setelah Penawaran &amp; Persetujuan Administrasi.</span>
                    </div>
                  </label>
                </div>

                <div class="bg-obsidian border border-gold/30 rounded-xl p-3.5 text-xs text-ash leading-relaxed">
                  <strong class="text-gold block mb-1">ℹ️ Belum Ada Transfer Uang di Tahap Ini</strong>
                  Setelah formulir dikirim, sistem mencetak <strong>Kartu Brief Visual</strong> untuk dikirim ke WhatsApp Produser (<span class="font-mono text-ivory">08977230597</span>). PrangArt Lab akan memeriksa materi, melakukan diskusi jika perlu, lalu menerbitkan <strong>Penawaran Resmi &amp; Perjanjian Produksi Musik</strong> sebelum tahap pembayaran dibuka.
                </div>

                <button type="submit" class="btn-gold w-full py-4 rounded-xl text-sm font-extrabold tracking-wide shadow-lg">
                  Kirim Pengajuan &amp; Cetak Kartu Brief →
                </button>
              </div>
            </div>

            <!-- RIGHT COLUMN: STICKY ESTIMATE CALCULATOR (4 COLS) -->
            <div class="lg:col-span-4 lg:sticky lg:top-22 space-y-4">
              <div class="bg-charcoal border border-gold/40 rounded-2xl p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between border-b border-borderline pb-3">
                  <span class="text-xs font-mono uppercase tracking-wider text-gold font-bold">Estimasi Biaya</span>
                  <span class="text-[10px] px-2 py-0.5 rounded bg-gold/15 text-gold font-mono">Referensi</span>
                </div>

                <div class="space-y-2 text-xs">
                  <div class="flex justify-between text-ash">
                    <span>Layanan</span>
                    <span id="calc-service-name" class="font-semibold text-ivory text-right">Produksi Musik Tari</span>
                  </div>
                  <div class="flex justify-between text-ash">
                    <span id="calc-pkg-name">Paket Standar (1,5 Juta)</span>
                    <span id="calc-pkg-price" class="font-mono text-ivory tabular-nums">Rp1.500.000</span>
                  </div>
                  <div id="calc-addon-row" class="hidden justify-between text-ash">
                    <span id="calc-addon-label">Tambahan Vokal</span>
                    <span id="calc-addon-price" class="font-mono text-gold tabular-nums">+Rp50.000</span>
                  </div>
                </div>

                <div class="border-t border-borderline pt-3 space-y-1">
                  <div class="flex items-baseline justify-between">
                    <span class="text-xs font-semibold text-ash">Estimasi Total Biaya</span>
                    <span id="calc-total-price" class="text-xl font-extrabold font-mono text-gold tabular-nums">Rp1.500.000</span>
                  </div>
                  <p id="calc-terbilang-total" class="text-[11px] italic text-ash">Terbilang: Satu Juta Lima Ratus Ribu Rupiah</p>
                </div>

                <div class="bg-obsidian border border-gold/30 rounded-xl p-3.5 space-y-1">
                  <div class="flex items-baseline justify-between">
                    <span id="calc-plan-title" class="text-xs font-bold text-ivory">Opsi DP 50% (Setelah Penawaran)</span>
                    <span id="calc-dp-price" class="text-base font-extrabold font-mono text-emerald-400 tabular-nums">Rp750.000</span>
                  </div>
                  <p id="calc-terbilang-dp" class="text-[11px] italic text-emerald-300/80">Terbilang: Tujuh Ratus Lima Puluh Ribu Rupiah</p>
                </div>

                <p class="text-[11px] text-ash leading-relaxed">
                  *Nominal final dan estimasi waktu pengerjaan akan dikonfirmasi resmi oleh Produser setelah pemeriksaan materi &amp; diskusi.
                </p>
              </div>
            </div>
          </form>
        </div>

        <!-- SUBMISSION SUCCESS & AUTOMATIC VISUAL BRIEF CARD HANDOFF -->
        <div id="order-success-container" class="hidden max-w-4xl mx-auto space-y-6 page-dissolve">
          <div class="bg-charcoal border border-gold/50 rounded-2xl p-6 sm:p-8 text-center space-y-3">
            <span class="inline-block px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-400 text-xs font-mono font-bold">✓ Pengajuan Kebutuhan Tercatat</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-ivory">Nomor Pengajuan: <span id="success-ticket-id" class="text-gold font-mono">PAL-2026-000</span></h2>
            <p class="text-xs sm:text-sm text-ash max-w-xl mx-auto">
              Gambar <strong>Kartu Brief PrangArt Lab</strong> Anda telah otomatis terunduh. Kirimkan gambar tersebut ke WhatsApp Produser (<span class="text-gold font-mono">08977230597</span>) untuk tahap <strong>Pemeriksaan Materi, Diskusi &amp; Penawaran Harga</strong>.
            </p>
          </div>

          <div class="bg-charcoal border border-borderline rounded-2xl p-4 sm:p-6 space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-gold font-bold">Pratinjau Kartu Brief Resmi (16:9 PNG)</span>
              <span class="text-[11px] text-ash">Tahap Selanjutnya: Pemeriksaan &amp; Diskusi</span>
            </div>
            <div class="rounded-xl overflow-hidden border border-gold/40 bg-obsidian">
              <img id="brief-card-preview-img" src="" alt="Kartu Brief PrangArt Lab" class="w-full h-auto block" />
            </div>
            <div class="rounded-xl overflow-hidden border border-gold/40 bg-obsidian">
              <img id="brief-card-preview-img" src="" alt="Kartu Brief PrangArt Studios" class="w-full h-auto block" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
              <button type="button" onclick="downloadCurrentBriefPNG()" class="btn-ghost-gold py-3 px-4 rounded-xl text-xs font-bold">
                ⬇ Unduh Kartu Brief (PNG)
              </button>
              <button type="button" onclick="sendBriefCardToProducerWA()" class="py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition">
                📲 Kirim Kartu Brief ke WA (08977230597)
              </button>
              <button type="button" onclick="navigateTo('client')" class="btn-gold py-3 px-4 rounded-xl text-xs font-bold">
                Pantau di Ruang Klien →
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- PAGE 4: CLIENT PORTAL (QUOTATION -> AGREEMENT -> PAYMENT -> MASTER) -->
    <!-- =================================================================== -->
    <section id="page-client" class="page-section hidden page-dissolve">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <!-- Client Login Wall -->
        <div id="client-login-wall" class="max-w-md mx-auto bg-charcoal border border-borderline rounded-2xl p-6 shadow-xl space-y-4">
          <div class="text-center">
            <span class="text-xs font-mono uppercase text-gold font-semibold">Ruang Klien</span>
            <h3 class="text-xl font-bold text-ivory mt-0.5">Masuk ke Akun Anda</h3>
            <p class="text-xs text-ash mt-1">Lihat penawaran resmi, setujui perjanjian, unggah bukti pembayaran, dan unduh hasil akhir.</p>
          </div>
          <form onsubmit="handleClientPortalLogin(event)" class="space-y-3.5">
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1">Email Terdaftar *</label>
              <input type="email" id="portal-login-email" required placeholder="siti@sanggar.id" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1">Kata Sandi *</label>
              <input type="password" id="portal-login-pass" required placeholder="1234" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
            <div class="flex items-center justify-between text-[11px] text-ash">
              <span>Akun Demo: <span class="font-mono text-gold">siti@sanggar.id</span> / <span class="font-mono text-gold">1234</span></span>
              <button type="button" onclick="openClientAuthModal('register')" class="text-gold font-semibold hover:underline">Daftar Baru</button>
            </div>
            <button type="submit" class="btn-gold w-full py-3 rounded-xl text-xs font-bold">Masuk Ruang Klien →</button>
          </form>
        </div>

        <!-- Client Workspace Content -->
        <div id="client-workspace-content" class="hidden space-y-6"></div>
      </div>
