    function closeWelcomeModal() {
      const m = document.getElementById('welcome-modal');
      m?.classList.add('hidden');
      m?.classList.remove('flex');
    }

    function openProducerWaModal(defaultIntent = '', defaultService = '', presetName = '', presetOrg = '') {
      const nameInput = document.getElementById('wa-comp-name');
      const orgInput = document.getElementById('wa-comp-org');
      const svcInput = document.getElementById('wa-comp-service');
      const intentInput = document.getElementById('wa-comp-intent');

      if (nameInput) nameInput.value = presetName || appState.currentClientUser?.name || '';
      if (orgInput) orgInput.value = presetOrg || (appState.currentClientUser ? `${appState.currentClientUser.instansi} — ${appState.currentClientUser.kota}` : '');
      if (svcInput && defaultService) {
        for (const opt of svcInput.options) {
          if (opt.value.toLowerCase().includes(defaultService.toLowerCase())) {
            svcInput.value = opt.value;
            break;
          }
        }
      }
      if (intentInput && defaultIntent) intentInput.value = defaultIntent;

      updateWaComposerPreview();
      const modal = document.getElementById('wa-producer-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeProducerWaModal() {
      const modal = document.getElementById('wa-producer-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    function updateWaComposerPreview() {
      const name = document.getElementById('wa-comp-name')?.value.trim() || '[Nama Anda]';
      const org = document.getElementById('wa-comp-org')?.value.trim();
      const svc = document.getElementById('wa-comp-service')?.value || 'Produksi Musik Tari';
      const intent = document.getElementById('wa-comp-intent')?.value.trim() || '[Kebutuhan / Rencana Diskusi]';

      const msg =
        `Halo Produser & Komposer PrangArt Lab,\n` +
        `Perkenalkan saya *${name}*${org ? ` (${org})` : ''}.\n` +
        `Layanan: *${svc}*\n\n` +
        `Hal yang ingin saya lakukan/diskusikan:\n${intent}`;

      const prev = document.getElementById('wa-comp-preview');
      if (prev) prev.textContent = msg;
      return msg;
    }

    function submitProducerWaMessage() {
      const name = document.getElementById('wa-comp-name')?.value.trim();
      const intent = document.getElementById('wa-comp-intent')?.value.trim();
      if (!name || !intent) {
        showToast('Lengkapi Pesan', 'Mohon isi Nama Anda dan hal yang ingin didiskusikan sebelum membuka WhatsApp.', 'warning');
        return;
      }
      const text = updateWaComposerPreview();
      const waUrl = `https://wa.me/${appState.settings.studioWhatsApp}?text=${encodeURIComponent(text)}`;
      window.open(waUrl, '_blank', 'noopener');
      closeProducerWaModal();
    }

    // -------------------------------------------------------------------------
    // CLIENT INSTANT ACCOUNT REGISTER / LOGIN
    // -------------------------------------------------------------------------
    function openClientAuthModal(tab = 'register') {
      switchAuthModalTab(tab);
      const m = document.getElementById('client-auth-modal');
      m?.classList.remove('hidden');
      m?.classList.add('flex');
    }

    function closeClientAuthModal() {
      const m = document.getElementById('client-auth-modal');
      m?.classList.add('hidden');
      m?.classList.remove('flex');
    }

    function switchAuthModalTab(tab) {
      const regTab = document.getElementById('auth-tab-register');
      const logTab = document.getElementById('auth-tab-login');
      const regForm = document.getElementById('form-client-register');
      const logForm = document.getElementById('form-client-login');

      if (tab === 'register') {
        regTab.className = 'py-2 rounded-lg text-xs font-bold bg-gold text-obsidian';
        logTab.className = 'py-2 rounded-lg text-xs font-semibold text-ash';
        regForm.classList.remove('hidden');
        logForm.classList.add('hidden');
      } else {
        logTab.className = 'py-2 rounded-lg text-xs font-bold bg-gold text-obsidian';
        regTab.className = 'py-2 rounded-lg text-xs font-semibold text-ash';
        logForm.classList.remove('hidden');
        regForm.classList.add('hidden');
      }
    }

    function handleQuickClientRegister(e) {
      e.preventDefault();
      const name = document.getElementById('reg-name').value.trim();
      const email = document.getElementById('reg-email').value.trim().toLowerCase();
      const wa = document.getElementById('reg-wa').value.trim();
      const instansi = document.getElementById('reg-instansi').value.trim();
      const kota = document.getElementById('reg-kota').value.trim();
      const pass = document.getElementById('reg-pass').value;

      const existing = appState.users.find(u => u.email === email);
      if (existing) {
        showToast('Email Sudah Terdaftar', 'Silakan masuk menggunakan tab Masuk Akun.', 'warning');
        switchAuthModalTab('login');
        document.getElementById('login-email').value = email;
        return;
      }

      const newUser = { name, email, wa, instansi, kota, pass };
      appState.users.push(newUser);
      appState.currentClientUser = newUser;
      syncUserToCloud(newUser);
      updateHeaderAuthBadge();
      closeClientAuthModal();
      showToast('Akun Berhasil Dibuat', `Selamat datang, ${name}! Data Anda otomatis terisi.`);
      if (appState.currentPage === 'order') refreshOrderPageUI();
      if (appState.currentPage === 'client') refreshClientPageUI();
    }

    function handleQuickClientLogin(e) {
      e.preventDefault();
      const email = document.getElementById('login-email').value.trim().toLowerCase();
      const pass = document.getElementById('login-pass').value;
      const found = appState.users.find(u => u.email === email && u.pass === pass);
      if (!found) {
        showToast('Gagal Masuk', 'Email atau kata sandi tidak cocok.', 'error');
        return;
      }
      appState.currentClientUser = found;
      updateHeaderAuthBadge();
      closeClientAuthModal();
      showToast('Berhasil Masuk', `Halo, ${found.name}.`);
      if (appState.currentPage === 'order') refreshOrderPageUI();
      if (appState.currentPage === 'client') refreshClientPageUI();
    }

    function logoutClientUser() {
      appState.currentClientUser = null;
      updateHeaderAuthBadge();
      showToast('Keluar Akun', 'Anda telah keluar dari sesi klien.');
      if (appState.currentPage === 'order') refreshOrderPageUI();
      if (appState.currentPage === 'client') refreshClientPageUI();
    }

    // -------------------------------------------------------------------------
    // ORDER / REQUIREMENT FORM (STEP 3 OF SOP — NO UPFRONT PAYMENT)
    // -------------------------------------------------------------------------
    function refreshOrderPageUI() {
      const banner = document.getElementById('order-account-banner');
      if (banner) {
        if (appState.currentClientUser) {
          const u = appState.currentClientUser;
          banner.innerHTML = `
            <div class="flex items-center gap-2.5">
              <span class="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 font-mono text-[11px] font-bold">✓ Akun Aktif</span>
              <span>Pemesan: <strong>${u.name}</strong> (${u.instansi} — ${u.kota})</span>
            </div>
          `;
          const setIfEmpty = (id, val) => {
            const el = document.getElementById(id);
            if (el && !el.value && val) el.value = val;
          };
          setIfEmpty('field-nama', u.name);
          setIfEmpty('field-email', u.email);
          setIfEmpty('field-wa', u.wa);
          setIfEmpty('field-instansi', u.instansi);
          setIfEmpty('field-kota', u.kota);
          setIfEmpty('field-alamat', u.alamat);
          setIfEmpty('field-nik', u.nik);
        } else {
          banner.innerHTML = `
            <div class="flex flex-wrap items-center gap-2">
              <span class="px-2 py-0.5 rounded bg-amber-500/15 text-amber-300 font-mono text-[11px] font-bold">Akun Klien</span>
              <span>Buat akun singkat (30 detik) agar progres penawaran &amp; dokumen tersimpan di akun Anda.</span>
              <button type="button" onclick="openClientAuthModal('register')" class="text-gold font-bold underline">Daftar / Masuk Sekarang</button>
            </div>
          `;
        }
      }
      selectServiceLine(appState.selectedServiceLine);
    }

    function selectServiceLine(svcKey) {
      appState.selectedServiceLine = svcKey;
      document.querySelectorAll('.svc-tab-btn').forEach(btn => {
        btn.className = 'svc-tab-btn p-3 rounded-xl border border-borderline bg-acoustic text-ash hover:text-ivory text-left transition';
      });
      const activeTab = document.getElementById(`svc-tab-${svcKey}`);
      if (activeTab) {
        activeTab.className = 'svc-tab-btn p-3 rounded-xl border border-gold bg-gold/15 text-ivory text-left transition';
      }

      renderPackageCards();
      renderDynamicSpecFields();
      recalculateLivePrice();
    }

    function renderPackageCards() {
      const grid = document.getElementById('package-cards-grid');
      if (!grid) return;
      const svc = appState.serviceCatalog[appState.selectedServiceLine];
      grid.innerHTML = Object.entries(svc.packages).map(([pkgKey, pkg]) => {
        const isSelected = appState.selectedPackage === pkgKey;
        return `
          <button type="button" onclick="selectPackageTier('${pkgKey}')" class="p-4 rounded-xl border text-left transition flex flex-col justify-between ${isSelected ? 'border-gold bg-gold/10 shadow-md' : 'border-borderline bg-acoustic/70 hover:border-gold/40'}">
            <div>
              <div class="flex items-center justify-between gap-1">
                <span class="text-xs font-bold text-ivory">${pkg.label}</span>
                ${isSelected ? '<span class="text-gold text-xs font-bold">✓</span>' : ''}
              </div>
              <span class="text-sm font-mono font-extrabold text-gold block mt-1">${formatRupiah(pkg.price)}</span>
              <p class="text-[11px] text-ash mt-1.5 leading-relaxed">${pkg.desc}</p>
            </div>
          </button>
        `;
      }).join('');
    }

    function selectPackageTier(pkgKey) {
      appState.selectedPackage = pkgKey;
      renderPackageCards();
      renderDynamicSpecFields();
      recalculateLivePrice();
    }

    function renderDynamicSpecFields() {
      const container = document.getElementById('dynamic-spec-fields');
      if (!container) return;
      const svc = appState.selectedServiceLine;
      const pkg = appState.selectedPackage;

      if (svc === 'tari') {
        if (pkg === 'dasar') {
          container.innerHTML = `
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-ivory mb-1.5">Tempo Utama (BPM) *</label>
                <input type="number" id="spec-dasar-bpm" value="110" min="40" max="240" required class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs font-mono text-ivory focus:outline-none" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-ivory mb-1.5">Nuansa Dominan *</label>
                <select id="spec-dasar-mood" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none">
                  <option value="Agung / Sakral">Agung / Sakral</option>
                  <option value="Dinamis / Energik">Dinamis / Energik</option>
                  <option value="Melankolis / Dramatik">Melankolis / Dramatik</option>
                  <option value="Ceria / Pesta Rakyat">Ceria / Pesta Rakyat</option>
                  <option value="Mistis / Magis">Mistis / Magis</option>
                </select>
              </div>
            </div>
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label class="block text-xs font-semibold text-ivory">Instrumen Utama (Maksimal 5 Instrumen) *</label>
                <span id="inst-counter" class="text-[11px] font-mono text-gold">${appState.basicInstruments.length}/5</span>
              </div>
              <div id="inst-input-box" class="flex gap-2">
                <input type="text" id="spec-inst-input" onkeydown="if(event.key==='Enter'){event.preventDefault();addBasicInstrument();}" placeholder="Ketik instrumen lalu tekan Enter (misal: Suling)..." class="flex-1 bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2 text-xs text-ivory focus:outline-none" />
                <button type="button" onclick="addBasicInstrument()" class="btn-ghost-gold px-3.5 py-2 rounded-xl text-xs font-bold">+ Tambah</button>
              </div>
              <div id="inst-tags-list" class="flex flex-wrap gap-2 mt-2.5"></div>
            </div>
          `;
          renderBasicInstrumentTags();
        } else if (pkg === 'standar') {
          const structures = ['Opening / Pembuka', 'Eksplorasi / Isi', 'Transisi / Jembatan', 'Klimaks / Puncak', 'Ending / Penutup'];
          container.innerHTML = `
            <div class="space-y-3">
              <label class="block text-xs font-semibold text-ivory">Pilih Struktur Tari &amp; Rincian Timestamp *</label>
              <div class="grid grid-cols-1 gap-3">
                ${structures.map((st, idx) => {
                  const checked = idx === 0 || idx === 3;
                  return `
                    <div class="bg-acoustic/70 border border-borderline rounded-xl p-3.5 space-y-2.5">
                      <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" class="std-struct-cb w-4 h-4 accent-[#d4af37]" data-idx="${idx}" data-name="${st}" ${checked ? 'checked' : ''} onchange="toggleStandarStructCard(${idx})" />
                        <span class="text-xs font-bold text-ivory">${st}</span>
                      </label>
                      <div id="std-struct-fields-${idx}" class="${checked ? 'grid' : 'hidden'} grid-cols-1 sm:grid-cols-12 gap-2.5 pt-1">
                        <div class="sm:col-span-4">
                          <input type="text" id="std-time-${idx}" placeholder="00:00 - 01:30" class="w-full bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-2 text-xs font-mono text-ivory focus:outline-none" />
                        </div>
                        <div class="sm:col-span-8">
                          <input type="url" id="std-link-${idx}" placeholder="Link GDrive referensi bagian ini (opsional)" class="w-full bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-2 text-xs text-ivory focus:outline-none" />
                        </div>
                        <div class="sm:col-span-12">
                          <textarea id="std-detail-${idx}" rows="2" placeholder="Uraian nuansa, tempo, &amp; dinamika gerak pada ${st}..." class="w-full bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-2 text-xs text-ivory focus:outline-none"></textarea>
                        </div>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `;
        } else {
          container.innerHTML = `
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <label class="block text-xs font-semibold text-ivory">Babak / Alur Dramatik &amp; Perubahan Tempo Bebas *</label>
                <button type="button" onclick="addProSceneBlock()" class="btn-ghost-gold px-3 py-1.5 rounded-lg text-xs font-bold">+ Tambah Babak Alur</button>
              </div>
              <div id="pro-scenes-list" class="space-y-3"></div>
            </div>
          `;
          renderProSceneBlocks();
        }
      } else if (svc === 'transkripsi') {
        container.innerHTML = `
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1.5">Jenis Notasi *</label>
              <select id="spec-trans-format" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none">
                <option value="Not Angka & Not Balok (Lengkap)">Not Angka &amp; Not Balok</option>
                <option value="Not Angka Saja">Not Angka Saja</option>
                <option value="Not Balok Saja">Not Balok Saja</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1.5">Tingkat Detail Notasi</label>
              <input type="text" id="spec-trans-key" placeholder="Contoh: Melodi + Akor / Full Partitur" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1.5">Format Hasil yang Diinginkan</label>
              <input type="text" id="spec-trans-meter" placeholder="Contoh: PDF Cetak + Audio Panduan" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-ivory mb-1.5">Instrumen / Jalur Suara yang Ditranskripsikan *</label>
            <textarea id="spec-trans-detail" rows="3" required placeholder="Contoh: Melodi utama vokal sopran-alto-tenor-bass beserta iringan piano..." class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none"></textarea>
          </div>
        `;
      } else {
        container.innerHTML = `
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1.5">Konsep &amp; Genre Musik *</label>
              <input type="text" id="spec-dig-genre" required placeholder="Contoh: Pop Orkestra / Etnik Elektronik / Teater" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
            <div>
              <label class="block text-xs font-semibold text-ivory mb-1.5">Durasi &amp; Target Tempo (BPM)</label>
              <input type="text" id="spec-dig-tempo" placeholder="Contoh: 120 BPM • G Mayor" class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none" />
            </div>
          </div>
          <div>
            <label class="block text-xs font-semibold text-ivory mb-1.5">Karakter, Suasana, Instrumen &amp; Kebutuhan Rekaman *</label>
            <textarea id="spec-dig-detail" rows="3" required placeholder="Jelaskan karakter suasana, susunan instrumen, dan kebutuhan rekaman..." class="w-full bg-acoustic border border-borderline focus:border-gold rounded-xl px-3.5 py-2.5 text-xs text-ivory focus:outline-none"></textarea>
          </div>
        `;
      }
    }

    function addBasicInstrument() {
      const inp = document.getElementById('spec-inst-input');
      const val = inp?.value.trim();
      if (!val) return;
      if (appState.basicInstruments.length >= 5) {
        const box = document.getElementById('inst-input-box');
        box?.classList.remove('shake-error');
        void box?.offsetWidth;
        box?.classList.add('shake-error');
        showToast('Batas Paket Dasar', 'Maksimal 5 instrumen untuk Paket Dasar.', 'warning');
        return;
      }
      appState.basicInstruments.push(val);
      inp.value = '';
      renderBasicInstrumentTags();
    }

    function removeBasicInstrument(idx) {
      appState.basicInstruments.splice(idx, 1);
      renderBasicInstrumentTags();
    }

    function renderBasicInstrumentTags() {
      const list = document.getElementById('inst-tags-list');
      const counter = document.getElementById('inst-counter');
      if (counter) counter.textContent = `${appState.basicInstruments.length}/5`;
      if (!list) return;
      list.innerHTML = appState.basicInstruments.map((inst, i) => `
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gold/15 border border-gold/40 text-gold text-xs font-semibold">
          <span>${inst}</span>
          <button type="button" onclick="removeBasicInstrument(${i})" class="hover:text-ivory">×</button>
        </span>
      `).join('');
    }

    function toggleStandarStructCard(idx) {
      const cb = document.querySelector(`.std-struct-cb[data-idx="${idx}"]`);
      const fields = document.getElementById(`std-struct-fields-${idx}`);
      if (!fields) return;
      if (cb?.checked) {
        fields.classList.remove('hidden');
        fields.classList.add('grid');
      } else {
        fields.classList.add('hidden');
        fields.classList.remove('grid');
      }
    }

    function addProSceneBlock() {
      const nextNum = appState.proScenes.length + 1;
      appState.proScenes.push({ title: `Babak ${nextNum}`, detail: '', link: '' });
      renderProSceneBlocks();
    }

    function removeProSceneBlock(idx) {
      if (appState.proScenes.length <= 1) return;
      appState.proScenes.splice(idx, 1);
      renderProSceneBlocks();
    }

    function renderProSceneBlocks() {
      const list = document.getElementById('pro-scenes-list');
      if (!list) return;
      list.innerHTML = appState.proScenes.map((sc, idx) => `
        <div class="bg-acoustic/70 border border-borderline rounded-xl p-3.5 space-y-2.5">
          <div class="flex items-center justify-between gap-2">
            <input type="text" value="${sc.title}" oninput="appState.proScenes[${idx}].title = this.value" placeholder="Nama Babak / Alur..." class="flex-1 bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-1.5 text-xs font-bold text-ivory focus:outline-none" />
            ${idx > 0 ? `<button type="button" onclick="removeProSceneBlock(${idx})" class="text-red-400 text-xs px-2 py-1 hover:bg-red-500/15 rounded">Hapus</button>` : ''}
          </div>
          <textarea rows="2" oninput="appState.proScenes[${idx}].detail = this.value" placeholder="Uraian perubahan tempo, dinamika, dan suasana alur ini..." class="w-full bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-2 text-xs text-ivory focus:outline-none">${sc.detail}</textarea>
          <input type="url" value="${sc.link}" oninput="appState.proScenes[${idx}].link = this.value" placeholder="Link Google Drive referensi tempo/gerak babak ini (opsional)" class="w-full bg-obsidian border border-borderline focus:border-gold rounded-lg px-3 py-1.5 text-xs text-ivory focus:outline-none" />
        </div>
      `).join('');
    }

    // Live Price Estimate Calculator
    function recalculateLivePrice() {
      const svc = appState.serviceCatalog[appState.selectedServiceLine];
      const pkg = svc.packages[appState.selectedPackage];
      const addonPriceLabelEl = document.getElementById('addon-vocal-price-label');
      if (addonPriceLabelEl) addonPriceLabelEl.textContent = `+${formatRupiah(svc.addonPrice)}`;
      const addonChecked = Boolean(document.getElementById('field-addon-vocal')?.checked);
      const addonCost = addonChecked ? svc.addonPrice : 0;
      const total = pkg.price + addonCost;
      const plan = document.querySelector('input[name="payment-plan"]:checked')?.value || 'DP 50%';
      const firstInstallment = plan === 'DP 50%' ? Math.round(total * 0.5) : total;

      document.getElementById('calc-service-name').textContent = svc.label;
      document.getElementById('calc-pkg-name').textContent = pkg.label;
      document.getElementById('calc-pkg-price').textContent = formatRupiah(pkg.price);

      const addonRow = document.getElementById('calc-addon-row');
      if (addonChecked) {
        addonRow.classList.remove('hidden');
        addonRow.classList.add('flex');
        document.getElementById('calc-addon-label').textContent = svc.addonLabel;
        document.getElementById('calc-addon-price').textContent = `+${formatRupiah(addonCost)}`;
      } else {
        addonRow.classList.add('hidden');
        addonRow.classList.remove('flex');
      }

      document.getElementById('calc-total-price').textContent = formatRupiah(total);
      document.getElementById('calc-terbilang-total').textContent = `Terbilang: ${numberToIndonesianWords(total)} Rupiah`;
      document.getElementById('calc-plan-title').textContent = plan === 'DP 50%' ? 'Opsi DP 50% (Setelah Penawaran)' : 'Opsi Penuh 100% (Setelah Penawaran)';
      document.getElementById('calc-dp-price').textContent = formatRupiah(firstInstallment);
      document.getElementById('calc-terbilang-dp').textContent = `Terbilang: ${numberToIndonesianWords(firstInstallment)} Rupiah`;

      const mobTotal = document.getElementById('mob-calc-total');
      const mobDp = document.getElementById('mob-calc-dp');
      if (mobTotal) mobTotal.textContent = formatRupiah(total);
      if (mobDp) mobDp.textContent = formatRupiah(firstInstallment);
    }

    function copyBankAccount() {
      const txt = appState.settings.bankAccount;
      const tmp = document.createElement('textarea');
      tmp.value = txt;
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand('copy');
      tmp.remove();
      showToast('Rekening Disalin', txt);
    }

    // AI Synopsis Generator
    async function generateAISynopsis(isVariation = false) {
      const judul = document.getElementById('field-judul')?.value.trim();
      const jenis = document.getElementById('field-jenis-tari')?.value.trim();
      const budaya = document.getElementById('field-budaya')?.value.trim();
      const sinopsisEl = document.getElementById('field-sinopsis');
      const btn = document.getElementById('btn-ai-synopsis');

      if (!judul || !jenis) {
        showToast('Data Belum Lengkap', 'Isi Judul Karya dan Jenis Karya terlebih dahulu agar AI dapat menyusun sinopsis.', 'warning');
        return;
      }

      if (!isVariation && sinopsisEl.value.trim()) {
        appState.previousSynopsisBackup = sinopsisEl.value;
      }

      btn.disabled = true;
      btn.textContent = '⏳ Menyusun Sinopsis...';

      const prompt = `Buatkan sinopsis singkat dan jelas (2 paragraf padat, maksimal 90 kata) untuk karya "${judul}" kategori "${jenis}" berlatar "${budaya || 'Nusantara'}". ${isVariation ? 'Gunakan sudut pandang narasi berbeda.' : ''}`;

      try {
        const apiKey = "";
        const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });
        if (!res.ok) throw new Error('API fallback');
        const data = await res.json();
        const generated = data?.candidates?.[0]?.content?.parts?.[0]?.text?.trim();
        if (!generated) throw new Error('Empty AI text');
        sinopsisEl.value = generated;
      } catch (_) {
        const variants = [
          `Karya "${judul}" menghadirkan alur dramatik berakar pada ${budaya || 'budaya Nusantara'} dalam balutan ${jenis}. Bagian pembuka mengalir tenang membangun suasana sebelum meningkat menuju dinamika ritmis yang tegas.\n\nPada puncak ketegangan, perpaduan dinamika dan aksen musikal menyimbolkan keteguhan karakter, lalu ditutup dengan harmoni yang berkesan.`,
          `Terinspirasi dari nilai ${budaya || 'tradisi lokal'}, "${judul}" merangkai ekspresi ${jenis} yang memadukan kehalusan rasa dan kekuatan tempo. Setiap pergeseran ritme menjadi penanda perubahan emosi dari keheningan menuju puncak klimaks.`
        ];
        sinopsisEl.value = variants[isVariation ? 1 : 0];
      } finally {
        btn.disabled = false;
        btn.textContent = '✨ Generate Sinopsis AI';
        const bar = document.getElementById('ai-synopsis-toolbar');
        bar?.classList.remove('hidden');
        bar?.classList.add('flex');
      }
    }

    function restorePreviousSynopsis() {
      const sinopsisEl = document.getElementById('field-sinopsis');
      if (sinopsisEl && appState.previousSynopsisBackup) {
        sinopsisEl.value = appState.previousSynopsisBackup;
        showToast('Teks Dikembalikan', 'Draf sinopsis sebelumnya dipulihkan.');
      }
    }

    function collectOrderMusicalSpec() {
      const svc = appState.selectedServiceLine;
      const pkg = appState.selectedPackage;
      if (svc === 'tari') {
        if (pkg === 'dasar') {
          return {
            mode: 'dasar',
            bpm: document.getElementById('spec-dasar-bpm')?.value || '110',
            mood: document.getElementById('spec-dasar-mood')?.value || 'Dinamis',
            instruments: [...appState.basicInstruments]
          };
        }
        if (pkg === 'standar') {
          const structures = [];
          document.querySelectorAll('.std-struct-cb:checked').forEach(cb => {
            const idx = cb.dataset.idx;
            structures.push({
              name: cb.dataset.name,
              time: document.getElementById(`std-time-${idx}`)?.value.trim() || '-',
              detail: document.getElementById(`std-detail-${idx}`)?.value.trim() || '-',
              link: document.getElementById(`std-link-${idx}`)?.value.trim() || ''
            });
          });
          return { mode: 'standar', structures };
        }
        return { mode: 'pro', scenes: structuredClone(appState.proScenes) };
      }
      if (svc === 'transkripsi') {
        return {
          mode: 'transkripsi',
          format: document.getElementById('spec-trans-format')?.value || 'Not Angka & Not Balok',
          key: document.getElementById('spec-trans-key')?.value.trim() || 'Melodi + Akor',
          meter: document.getElementById('spec-trans-meter')?.value.trim() || 'PDF Cetak',
          detail: document.getElementById('spec-trans-detail')?.value.trim() || '-'
        };
      }
      return {
        mode: 'digital',
        genre: document.getElementById('spec-dig-genre')?.value.trim() || '-',
        tempo: document.getElementById('spec-dig-tempo')?.value.trim() || '-',
        detail: document.getElementById('spec-dig-detail')?.value.trim() || '-'
      };
    }

    // Submit Requirement Form -> Create Brief Card PNG & Handover to Producer WA
    async function handleOrderFormSubmit(e) {
      e.preventDefault();
      if (!appState.currentClientUser) {
        showToast('Buat Akun Terlebih Dahulu', 'Silakan daftar atau masuk akun singkat agar progres dapat dipantau.', 'warning');
        openClientAuthModal('register');
        return;
      }

      const entryPath = document.querySelector('input[name="entry-path"]:checked')?.value || 'Jalur A (Sudah Diskusi WA)';
      const paymentScheme = document.querySelector('input[name="payment-plan"]:checked')?.value || 'DP 50%';
      const nama = document.getElementById('field-nama').value.trim();
      const email = document.getElementById('field-email').value.trim().toLowerCase();
      const wa = document.getElementById('field-wa').value.trim();
      const kota = document.getElementById('field-kota').value.trim();
      const alamat = document.getElementById('field-alamat')?.value.trim() || kota;
      const nik = document.getElementById('field-nik')?.value.trim() || '';
      const instansi = document.getElementById('field-instansi').value.trim();
      const koreografer = document.getElementById('field-koreografer').value.trim();
      const judul = document.getElementById('field-judul').value.trim();
      const jenisTari = document.getElementById('field-jenis-tari').value.trim();
      const budaya = document.getElementById('field-budaya').value.trim();
      const durasi = document.getElementById('field-durasi').value.trim();
      const referensi = document.getElementById('field-referensi').value.trim();
      const sinopsis = document.getElementById('field-sinopsis').value.trim();

      const svcObj = appState.serviceCatalog[appState.selectedServiceLine];
      const pkgObj = svcObj.packages[appState.selectedPackage];
      const addonSelected = Boolean(document.getElementById('field-addon-vocal')?.checked);
      const addonPrice = addonSelected ? svcObj.addonPrice : 0;
      const totalPrice = pkgObj.price + addonPrice;
      const dpAmount = paymentScheme === 'DP 50%' ? Math.round(totalPrice * 0.5) : totalPrice;

      const seqNum = String(Math.floor(100 + Math.random() * 899));
      const ticketId = `PAL-2026-${seqNum}`;
      const nowDate = new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
      const musicalSpec = collectOrderMusicalSpec();
      const defaultRev = appState.selectedPackage === 'dasar' ? '3' : appState.selectedPackage === 'standar' ? '6' : 'Sesuai kesepakatan';

      const newProject = {
        id: ticketId,
        createdTs: Date.now(),
        createdAt: nowDate,
        entryPath,
        clientEmail: email,
        clientName: nama,
        instansi,
        kota,
        alamat,
        nik,
        wa,
        serviceLine: appState.selectedServiceLine,
        serviceLineLabel: svcObj.label,
        packageKey: appState.selectedPackage,
        packageName: pkgObj.label,
        addonSelected,
        addonLabel: svcObj.addonLabel,
        addonPrice: svcObj.addonPrice,
        basePrice: pkgObj.price,
        totalPrice,
        dpAmount,
        paymentScheme,
        judul,
        koreografer,
        jenisTari,
        budaya,
        durasi,
        referensi,
        sinopsis,
        musicalSpec,
        contractNumber: `${seqNum}/PAL-SPK/XI/2026`,
        composerRole: 'Composer & Arranger',
        musicFileTitle: judul.replace(/\s+/g, '_') + '_Final',
        deliverableFormat: appState.selectedServiceLine === 'transkripsi' ? 'PDF Partitur & Audio Panduan' : 'WAV 24-bit & MP3 320kbps',
        revisionQuota: defaultRev,
        thirdPartyMaterial: 'Tidak ada',
        collaboratorNotes: 'Tidak ada kontributor tambahan',
        rawFilesIncluded: false,
        rawFilesDetail: '',
        extraAttachmentNotes: '-',
        courtCity: 'Samarinda',
        quoteStatus: 'Menunggu Pemeriksaan',
        quoteDurationDays: '7–10 Hari Kerja',
        quoteDeliverables: 'Sesuai Lampiran A & paket yang disepakati',
        quoteNotes: '',
        agreementSigned: false,
        agreementSignedAt: '',
        dpStatus: 'Belum Dibayar',
        dpRejectReason: '',
        dpProofName: '',
        dpProofDataUrl: '',
        pelunasanStatus: paymentScheme === 'Pembayaran Penuh 100%' ? 'Tidak Perlu (Skema Penuh)' : 'Belum Lunas',
        pelunasanProofName: '',
        pelunasanProofDataUrl: '',
        productionStatus: TRACKER_MILESTONES[0],
        previewAudioName: '',
        previewAudioUrl: '',
        masterFileName: '',
        masterFileUrl: '',
        clientAcceptedFinal: false
      };

      appState.projects.unshift(newProject);
      appState.activeBriefProjectId = ticketId;
      appState.selectedClientProjectId = ticketId;
      appState.selectedAdminProjectId = ticketId;
      await syncProjectToCloud(newProject);

      const briefDataUrl = await generateBriefCardPNGDataUrl(newProject);
      document.getElementById('success-ticket-id').textContent = ticketId;
      document.getElementById('brief-card-preview-img').src = briefDataUrl;

      document.getElementById('order-form-container').classList.add('hidden');
      document.getElementById('mobile-sticky-bar')?.classList.add('hidden');
      document.getElementById('order-success-container').classList.remove('hidden');

      triggerPngFileDownload(briefDataUrl, `Kartu-Brief-PrangArt-${ticketId}.png`);
      showToast('Kartu Brief Terunduh!', 'Kirim Kartu Brief PNG ke WhatsApp Produser untuk pemeriksaan & penawaran.');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // -------------------------------------------------------------------------
    // 16:9 VISUAL BRIEF CARD GENERATOR
    // -------------------------------------------------------------------------
    function loadImageElement(src) {
      return new Promise(resolve => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = () => resolve(null);
        img.src = src;
      });
    }

    function drawGoldPillBadge(ctx, x, y, w, h, label) {
      const grad = ctx.createLinearGradient(x, y, x + w, y);
      grad.addColorStop(0, '#b5892e');
      grad.addColorStop(0.5, '#e8c967');
      grad.addColorStop(1, '#b5892e');
      ctx.fillStyle = grad;
      ctx.beginPath();
      ctx.roundRect(x, y, w, h, h / 2);
      ctx.fill();

      ctx.fillStyle = '#09090b';
      ctx.font = 'bold 16px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(label, x + 18, y + 23);
    }

    async function generateBriefCardPNGDataUrl(proj) {
      const c = document.createElement('canvas');
      c.width = 1600;
      c.height = 900;
      const ctx = c.getContext('2d');

      const bgGrad = ctx.createLinearGradient(0, 0, 1600, 900);
      bgGrad.addColorStop(0, '#09090b');
      bgGrad.addColorStop(0.5, '#12110e');
      bgGrad.addColorStop(1, '#09090b');
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, 1600, 900);

      ctx.strokeStyle = '#d4af37';
      ctx.lineWidth = 4;
      ctx.beginPath(); ctx.moveTo(0, 75); ctx.quadraticCurveTo(95, 65, 165, 0); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(1360, 900); ctx.quadraticCurveTo(1470, 810, 1600, 730); ctx.stroke();

      const logoImg = await loadImageElement(LOGO_URL);
      if (logoImg) ctx.drawImage(logoImg, 65, 28, 78, 78);
      ctx.fillStyle = '#f4f4f5';
      ctx.font = 'bold 28px Georgia, serif';
      ctx.textAlign = 'left';
      ctx.fillText('PrangArt Lab', 158, 66);
      ctx.fillStyle = '#d4af37';
      ctx.font = '14px "Plus Jakarta Sans", sans-serif';
      ctx.fillText('— Seni • Budaya • Kreasi —', 160, 90);

      ctx.strokeStyle = 'rgba(212, 175, 55, 0.5)';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(430, 32); ctx.lineTo(430, 102); ctx.stroke();

      ctx.fillStyle = '#f4f4f5';
      ctx.font = 'italic bold 36px Georgia, serif';
      ctx.textAlign = 'center';
      ctx.fillText(`——  ${proj.judul}  ——`, 1010, 78, 1050);

      const drawSectionBox = (x, y, w, h) => {
        ctx.fillStyle = 'rgba(18, 18, 21, 0.92)';
        ctx.strokeStyle = '#d4af37';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.roundRect(x, y, w, h, 16);
        ctx.fill();
        ctx.stroke();
      };

      drawSectionBox(45, 145, 610, 165);
      drawGoldPillBadge(ctx, 60, 127, 230, 34, '👤  Informasi Pemesan');
      ctx.textAlign = 'left';
      ctx.font = '16px "Plus Jakarta Sans", sans-serif';
      const infoRows = [
        ['Nama Lengkap', proj.clientName],
        ['Email', proj.clientEmail],
        ['Nomor WhatsApp', proj.wa],
        ['Asal Pemesan', proj.kota]
      ];
      infoRows.forEach((r, idx) => {
        const ry = 186 + idx * 29;
        ctx.fillStyle = '#d4af37';
        ctx.fillText(r[0], 70, ry);
        ctx.fillText(':', 225, ry);
        ctx.fillStyle = '#f4f4f5';
        ctx.fillText(r[1] || '-', 242, ry, 390);
      });

      drawSectionBox(685, 145, 870, 165);
      drawGoldPillBadge(ctx, 700, 127, 215, 34, '👥  Identitas Karya');
      const idRows = [
        ['Sanggar / Komunitas / Instansi', proj.instansi],
        ['Koreografer / Pencipta', proj.koreografer],
        ['Penata Musik / Komposer', appState.settings.directorName]
      ];
      idRows.forEach((r, idx) => {
        const ry = 192 + idx * 36;
        ctx.fillStyle = '#d4af37';
        ctx.fillText(r[0], 710, ry);
        ctx.fillText(':', 990, ry);
        ctx.fillStyle = '#f4f4f5';
        ctx.fillText(r[1] || '-', 1010, ry, 520);
      });

      drawSectionBox(45, 345, 1510, 165);
      drawGoldPillBadge(ctx, 60, 327, 165, 34, '🪶  Sinopsis');
      ctx.fillStyle = '#f4f4f5';
      ctx.font = '16px "Plus Jakarta Sans", sans-serif';
      wrapCanvasText(ctx, proj.sinopsis, 1450).slice(0, 5).forEach((line, idx) => {
        ctx.fillText(line, 70, 388 + idx * 25);
      });

      drawSectionBox(45, 545, 490, 165);
      drawGoldPillBadge(ctx, 60, 527, 210, 34, '🎵  Referensi Musik');
      ctx.fillStyle = '#f4f4f5';
      ctx.font = '15px "Plus Jakarta Sans", sans-serif';
      const refSummary = `Layanan: ${proj.serviceLineLabel}\nPaket: ${proj.packageName} (${proj.durasi})\nLink: ${proj.referensi}`;
      wrapCanvasText(ctx, refSummary, 445).slice(0, 5).forEach((line, idx) => {
        ctx.fillText(line, 70, 588 + idx * 24);
      });

      drawSectionBox(45, 740, 490, 88);
      drawGoldPillBadge(ctx, 60, 722, 225, 34, '🎙️  Tambahan Layanan');
      ctx.fillStyle = proj.addonSelected ? '#34d399' : '#a1a1aa';
      ctx.font = 'bold 16px "Plus Jakarta Sans", sans-serif';
      const vokalTxt = proj.addonSelected
        ? `YA — ${proj.addonLabel} (+${formatRupiah(proj.addonPrice)})`
        : 'Tidak Menggunakan Tambahan Vokal/Partitur';
      ctx.fillText(vokalTxt, 70, 788, 445);

      drawSectionBox(565, 545, 990, 283);
      drawGoldPillBadge(ctx, 580, 527, 340, 34, '📊  Uraian Nuansa / Tempo / Struktur');
      ctx.fillStyle = '#f4f4f5';
      ctx.font = '15px "Plus Jakarta Sans", sans-serif';
      buildMusicalSpecSummaryLines(proj).slice(0, 9).forEach((line, idx) => {
        ctx.fillText(line, 590, 588 + idx * 25, 940);
      });

      ctx.strokeStyle = 'rgba(212, 175, 55, 0.45)';
      ctx.beginPath(); ctx.moveTo(45, 848); ctx.lineTo(1555, 848); ctx.stroke();

      ctx.fillStyle = '#d4af37';
      ctx.font = 'bold 16px "Plus Jakarta Sans", sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText('IG: prangart.studios    |    WA: 08977230597    |    Email: prangart.studios@gmail.com', 55, 878);
      ctx.textAlign = 'right';
      ctx.fillText(`Kode: ${proj.id} • Estimasi: ${formatRupiah(proj.totalPrice)} (${proj.paymentScheme})`, 1545, 878);

      return c.toDataURL('image/png');
    }

    function buildMusicalSpecSummaryLines(proj) {
      const s = proj.musicalSpec || {};
      const lines = [
        `• Jalur: ${proj.entryPath || 'Jalur A'} | Skema: ${proj.paymentScheme || 'DP 50%'} | Hak Ekonomi: Termasuk (Pasal 3)`
      ];
      if (s.mode === 'dasar') {
        lines.push(`• Tempo Utama: ${s.bpm} BPM  |  Nuansa Dominan: ${s.mood}`);
        lines.push(`• Instrumen Utama: ${(s.instruments || []).join(', ') || '-'}`);
      } else if (s.mode === 'standar') {
        (s.structures || []).forEach(st => {
          lines.push(`• [${st.time}] ${st.name}: ${st.detail}`);
        });
      } else if (s.mode === 'pro') {
        (s.scenes || []).forEach(sc => {
          lines.push(`• ${sc.title}: ${sc.detail}`);
        });
      } else if (s.mode === 'transkripsi') {
        lines.push(`• Jenis: ${s.format} | Detail: ${s.key} | Format Hasil: ${s.meter}`);
        lines.push(`• Rincian: ${s.detail}`);
      } else {
        lines.push(`• Genre: ${s.genre || '-'} | Tempo/Nada: ${s.tempo || '-'}`);
        lines.push(`• Uraian: ${s.detail || '-'}`);
      }
      return lines;
    }

    async function downloadCurrentBriefPNG() {
      const proj = appState.projects.find(p => p.id === appState.activeBriefProjectId);
      if (!proj) return;
      const url = await generateBriefCardPNGDataUrl(proj);
      triggerPngFileDownload(url, `Kartu-Brief-PrangArt-${proj.id}.png`);
    }

    function sendBriefCardToProducerWA() {
      const proj = appState.projects.find(p => p.id === appState.activeBriefProjectId);
      if (!proj) return;
      const intent =
        `Pengajuan Kebutuhan (${proj.id}) — ${proj.entryPath}\n` +
        `Judul Karya: ${proj.judul}\n` +
        `Layanan: ${proj.serviceLineLabel} — ${proj.packageName}\n` +
        `Estimasi Biaya: ${formatRupiah(proj.totalPrice)} (Rencana: ${proj.paymentScheme})\n` +
        `Saya lampirkan Gambar Kartu Brief PrangArt Lab untuk pemeriksaan materi & diskusi penawaran.`;
      openProducerWaModal(intent, proj.serviceLineLabel, proj.clientName, `${proj.instansi} — ${proj.kota}`);
    }

    async function openBriefCardModal(projId) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      appState.activeBriefProjectId = projId;
      const url = await generateBriefCardPNGDataUrl(proj);
      document.getElementById('modal-brief-img').src = url;
      const modal = document.getElementById('brief-card-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeBriefCardModal() {
      const modal = document.getElementById('brief-card-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    // -------------------------------------------------------------------------
    // PAGE 4: CLIENT PORTAL (QUOTATION -> AGREEMENT -> PAYMENT -> DELIVERABLES)
    // -------------------------------------------------------------------------
    function handleClientPortalLogin(e) {
      e.preventDefault();
      const email = document.getElementById('portal-login-email').value.trim().toLowerCase();
      const pass = document.getElementById('portal-login-pass').value;
      const found = appState.users.find(u => u.email === email && u.pass === pass);
      if (!found) {
        showToast('Gagal Masuk', 'Email atau kata sandi tidak sesuai.', 'error');
        return;
      }
      appState.currentClientUser = found;
      updateHeaderAuthBadge();
      refreshClientPageUI();
    }

    function refreshClientPageUI() {
      const wall = document.getElementById('client-login-wall');
      const ws = document.getElementById('client-workspace-content');
      if (!appState.currentClientUser) {
        wall?.classList.remove('hidden');
        ws?.classList.add('hidden');
        return;
      }
      wall?.classList.add('hidden');
      ws?.classList.remove('hidden');
      renderClientWorkspace();
    }

    function renderClientWorkspace() {
      const ws = document.getElementById('client-workspace-content');
      if (!ws || !appState.currentClientUser) return;
      const myProjects = appState.projects.filter(p => p.clientEmail === appState.currentClientUser.email);

      if (!myProjects.length) {
        ws.innerHTML = `
          <div class="bg-charcoal border border-borderline rounded-2xl p-10 text-center max-w-lg mx-auto space-y-4">
            <span class="text-3xl block">🎼</span>
            <h3 class="text-lg font-bold text-ivory">Belum Ada Pengajuan Aktif</h3>
            <p class="text-xs text-ash">Mulai diskusi dengan Produser atau isi formulir pengajuan kebutuhan pertama Anda.</p>
            <div class="flex justify-center gap-2">
              <button type="button" onclick="openProducerWaModal()" class="btn-ghost-gold px-4 py-2.5 rounded-xl text-xs font-bold">💬 Diskusi WA</button>
              <button type="button" onclick="navigateTo('order')" class="btn-gold px-4 py-2.5 rounded-xl text-xs font-bold">Isi Formulir →</button>
            </div>
          </div>
        `;
        return;
      }

      if (!myProjects.some(p => p.id === appState.selectedClientProjectId)) {
        appState.selectedClientProjectId = myProjects[0].id;
      }
      const proj = myProjects.find(p => p.id === appState.selectedClientProjectId);
      const currentMilestoneIdx = Math.max(0, TRACKER_MILESTONES.indexOf(proj.productionStatus));
      const isFullScheme = proj.paymentScheme === 'Pembayaran Penuh 100%';
      const firstPayAmount = isFullScheme ? proj.totalPrice : proj.dpAmount;
      const pelunasanAmount = isFullScheme ? 0 : (proj.totalPrice - proj.dpAmount);
      const isQuoteIssued = proj.quoteStatus === 'Diterbitkan';
      const isAgreementSigned = Boolean(proj.agreementSigned);
      const isFirstPaymentVerified = proj.dpStatus === 'Terverifikasi';
      const isFullyPaid = isFullScheme ? isFirstPaymentVerified : (proj.pelunasanStatus === 'Lunas');

      ws.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-3 bg-charcoal border border-borderline rounded-2xl p-4">
          <div>
            <span class="text-[11px] font-mono text-gold uppercase font-bold">Ruang Klien • ${appState.currentClientUser.name}</span>
            <h2 class="text-xl font-bold text-ivory">${proj.judul} <span class="text-xs font-mono text-ash">(${proj.id})</span></h2>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            ${myProjects.length > 1 ? `
              <select onchange="appState.selectedClientProjectId = this.value; renderClientWorkspace()" class="bg-acoustic border border-borderline rounded-xl px-3 py-2 text-xs text-ivory">
                ${myProjects.map(p => `<option value="${p.id}" ${p.id === proj.id ? 'selected' : ''}>${p.id} — ${p.judul}</option>`).join('')}
              </select>
            ` : ''}
            <button type="button" onclick="navigateTo('order')" class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold">+ Ajukan Baru</button>
          </div>
        </div>

        <!-- 8-Milestone SOP Progress Tracker -->
        <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="text-xs font-mono uppercase text-gold font-bold">Progres Tahapan Produksi</span>
            <span class="px-2.5 py-0.5 rounded-full bg-gold/15 text-gold text-xs font-bold">${proj.productionStatus}</span>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2">
            ${TRACKER_MILESTONES.map((st, idx) => {
              const done = idx <= currentMilestoneIdx;
              return `
                <div class="p-2.5 rounded-xl border ${done ? 'border-gold bg-gold/10' : 'border-borderline bg-acoustic/50 opacity-50'}">
                  <span class="text-[10px] font-mono font-bold ${done ? 'text-gold' : 'text-ash'}">0${idx + 1}</span>
                  <p class="text-[11px] font-semibold text-ivory mt-0.5 leading-snug">${st.replace(/^\d+\.\s*/, '')}</p>
                </div>
              `;
            }).join('')}
          </div>
        </div>

        <!-- STEP 6, 7, 8: PENAWARAN RESMI -> PERSETUJUAN ADMINISTRASI -> PEMBAYARAN -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
          <!-- Card A: Tahap 6 Penawaran Harga -->
          <div class="bg-charcoal border ${isQuoteIssued ? 'border-emerald-500/40' : 'border-borderline'} rounded-2xl p-5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-gold uppercase">Tahap 6 • Penawaran Resmi</span>
              <span class="text-[11px] font-mono ${isQuoteIssued ? 'text-emerald-400' : 'text-amber-300'}">${proj.quoteStatus}</span>
            </div>
            ${isQuoteIssued ? `
              <div class="space-y-1.5 text-xs">
                <p class="text-ash">Biaya Resmi: <strong class="text-ivory font-mono">${formatRupiah(proj.totalPrice)}</strong></p>
                <p class="text-ash">Estimasi Pengerjaan: <strong class="text-ivory">${proj.quoteDurationDays}</strong></p>
                <p class="text-ash">Hasil Diserahkan: <strong class="text-ivory">${proj.quoteDeliverables}</strong></p>
                ${proj.quoteNotes ? `<p class="text-[11px] italic text-gold">"${proj.quoteNotes}"</p>` : ''}
              </div>
            ` : `
              <p class="text-xs text-ash leading-relaxed">
                PrangArt Studios sedang memeriksa materi brief Anda &amp; menyiapkan penawaran harga resmi. Silakan lanjutkan diskusi di WhatsApp bila diperlukan.
              </p>
              <button type="button" onclick="launchWhatsAppProjectDiscussion('${proj.id}')" class="btn-ghost-gold w-full py-2 rounded-xl text-xs font-bold">
                💬 Diskusi Materi di WA
              </button>
            `}
          </div>

          <!-- Card B: Tahap 7 Persetujuan Administrasi -->
          <div class="bg-charcoal border ${isAgreementSigned ? 'border-emerald-500/40' : 'border-borderline'} rounded-2xl p-5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-gold uppercase">Tahap 7 • Persetujuan Admin</span>
              <span class="text-[11px] font-mono ${isAgreementSigned ? 'text-emerald-400' : 'text-amber-300'}">${isAgreementSigned ? '✓ Disetujui' : 'Menunggu'}</span>
            </div>
            <p class="text-xs text-ash leading-relaxed">
              ${proj.serviceLine === 'transkripsi'
                ? 'Persetujuan penawaran dan ketentuan layanan transkripsi musik secara elektronik.'
                : 'Penandatanganan Perjanjian Produksi Musik oleh kedua pihak sebelum pembayaran.'}
            </p>
            ${isAgreementSigned ? `
              <button type="button" onclick="openContractDocModal('${proj.id}', false)" class="btn-ghost-gold w-full py-2.5 rounded-xl text-xs font-bold">
                📜 Lihat Dokumen yang Disetujui
              </button>
            ` : isQuoteIssued ? `
              <button type="button" onclick="openContractDocModal('${proj.id}', true)" class="btn-gold w-full py-2.5 rounded-xl text-xs font-bold">
                ✍️ Baca &amp; Setujui Sekarang
              </button>
            ` : `
              <button type="button" disabled class="w-full py-2.5 rounded-xl bg-acoustic text-ash text-xs font-semibold cursor-not-allowed">
                Menunggu Penawaran Resmi
              </button>
            `}
          </div>

          <!-- Card C: Tahap 8 Pembayaran (DP 50% atau Penuh 100%) -->
          <div class="bg-charcoal border ${isFirstPaymentVerified ? 'border-emerald-500/40' : 'border-borderline'} rounded-2xl p-5 space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono font-bold text-gold uppercase">Tahap 8 • Pembayaran</span>
              <span class="text-[11px] font-mono ${isFirstPaymentVerified ? 'text-emerald-400' : 'text-amber-300'}">${proj.dpStatus}</span>
            </div>
            ${isAgreementSigned ? `
              <div class="space-y-2.5 text-xs">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-ash">Skema:</span>
                  <select onchange="changeClientPaymentScheme('${proj.id}', this.value)" ${isFirstPaymentVerified ? 'disabled' : ''} class="bg-acoustic border border-borderline rounded-lg px-2 py-1 text-xs text-ivory">
                    <option value="DP 50%" ${!isFullScheme ? 'selected' : ''}>DP 50% (${formatRupiah(proj.dpAmount)})</option>
                    <option value="Pembayaran Penuh 100%" ${isFullScheme ? 'selected' : ''}>Penuh 100% (${formatRupiah(proj.totalPrice)})</option>
                  </select>
                </div>
                <div class="bg-obsidian border border-borderline rounded-lg p-2.5 flex items-center justify-between gap-2">
                  <span class="font-mono text-[11px] text-ivory truncate">${appState.settings.bankAccount}</span>
                  <button type="button" onclick="copyBankAccount()" class="text-gold text-[11px] font-bold shrink-0">Salin</button>
                </div>
                ${proj.dpStatus === 'Ditolak' ? `<p class="text-[11px] text-red-400">${proj.dpRejectReason}</p>` : ''}
                ${!isFirstPaymentVerified ? `
                  <label class="btn-gold w-full py-2.5 rounded-xl text-xs font-bold text-center block cursor-pointer">
                    📤 Unggah Bukti Transfer (${formatRupiah(firstPayAmount)})
                    <input type="file" accept="image/jpeg,image/png,application/pdf" onchange="uploadClientStagePayment('${proj.id}', 'dp', this.files[0])" class="hidden" />
          <!-- Tahap 6 & 7: Penawaran Harga & Pengaturan Lampiran A/B Perjanjian -->
          <div class="bg-acoustic border border-gold/30 rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <strong class="text-xs text-gold uppercase font-mono">Tahap 6 &amp; 7 • Penawaran Resmi &amp; Lampiran A Perjanjian</strong>
              <span class="text-[11px] font-mono text-ivory">Status: ${proj.quoteStatus}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
              <div>
                <label class="block text-[11px] text-ash mb-1">Biaya Final (Rp)</label>
                <input type="number" id="admin-quote-price" value="${proj.totalPrice}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 font-mono text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Kedudukan Pihak I (Lampiran A)</label>
                <select id="admin-composer-role" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory">
                  <option value="Composer" ${(proj.composerRole || '') === 'Composer' ? 'selected' : ''}>Composer</option>
                  <option value="Arranger" ${(proj.composerRole || '') === 'Arranger' ? 'selected' : ''}>Arranger</option>
                  <option value="Composer & Arranger" ${(proj.composerRole || 'Composer & Arranger') === 'Composer & Arranger' ? 'selected' : ''}>Composer &amp; Arranger</option>
                  <option value="Tim produksi saja" ${(proj.composerRole || '') === 'Tim produksi saja' ? 'selected' : ''}>Tim produksi saja</option>
                </select>
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Kuota Revisi Ringan (Pasal 8)</label>
                <input type="text" id="admin-quote-rev" value="${proj.revisionQuota || '6'}" placeholder="Contoh: 3 / 6" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 font-mono text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Format File Diserahkan</label>
                <input type="text" id="admin-quote-deliver" value="${proj.deliverableFormat || 'WAV 24-bit & MP3 320kbps'}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Estimasi Waktu Pengerjaan</label>
                <input type="text" id="admin-quote-days" value="${proj.quoteDurationDays || '7–10 Hari Kerja'}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Kolaborator (Lampiran B)</label>
                <input type="text" id="admin-collab-notes" value="${proj.collaboratorNotes || 'Tidak ada kontributor tambahan'}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory" />
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <input type="text" id="admin-quote-notes" value="${proj.quoteNotes || ''}" placeholder="Catatan tambahan penawaran / Lampiran A..." class="flex-1 bg-obsidian border border-borderline rounded-lg px-3 py-2 text-xs text-ivory" />
              <button type="button" onclick="issueOfficialQuotation('${proj.id}')" class="btn-gold px-4 py-2 rounded-xl text-xs font-bold shrink-0">
                📨 Terbitkan Penawaran &amp; Perjanjian
              </button>
            </div>
          </div>

          <div class="lg:col-span-5 bg-charcoal border border-borderline rounded-2xl p-5 space-y-4">
            <h3 class="text-sm font-bold text-ivory">📂 Dokumen, Pelunasan &amp; Hasil Akhir</h3>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" onclick="openOfficialDocModal('${proj.id}', 'invoice', '${isFullScheme ? 'full' : (isFullyPaid ? 'lunas' : 'dp')}')" class="btn-ghost-gold py-2 rounded-lg text-xs font-bold">📄 Invoice</button>
              <button type="button" onclick="openOfficialDocModal('${proj.id}', 'kuitansi', '${isFullScheme ? 'full' : (isFullyPaid ? 'lunas' : 'dp')}')" class="btn-ghost-gold py-2 rounded-lg text-xs font-bold">🧾 Kuitansi</button>
              <button type="button" onclick="openBriefCardModal('${proj.id}')" class="py-2 rounded-lg bg-acoustic border border-gold/40 text-gold text-xs font-bold hover:border-gold">🎨 Kartu Brief</button>
              <button type="button" onclick="openContractDocModal('${proj.id}', false)" class="py-2 rounded-lg bg-acoustic border border-gold/40 text-gold text-xs font-bold hover:border-gold">📜 Perjanjian</button>
            </div>

            ${!isFullScheme && !isFullyPaid && isFirstPaymentVerified ? `
              <div class="bg-obsidian border border-gold/30 rounded-xl p-3.5 space-y-2.5">
                <p class="text-[11px] text-ash">Tahap 12: Unggah bukti pelunasan sisa <strong>${formatRupiah(pelunasanAmount)}</strong> sebelum hasil akhir diserahkan:</p>
                <label class="btn-gold w-full py-2.5 rounded-xl text-xs font-bold text-center block cursor-pointer">
                  📤 Unggah Bukti Pelunasan (${formatRupiah(pelunasanAmount)})
                  <input type="file" accept="image/jpeg,image/png,application/pdf" onchange="uploadClientStagePayment('${proj.id}', 'lunas', this.files[0])" class="hidden" />
                </label>
              </div>
            ` : ''}

            <div class="pt-2 border-t border-borderline space-y-2">
              ${isFullyPaid ? `
                <button type="button" onclick="downloadMasterAsset('${proj.id}')" class="btn-gold w-full py-3 rounded-xl text-xs font-extrabold">
                  ⬇ Unduh Hasil Akhir (${proj.masterFileName || 'MASTER_FINAL.wav'})
                </button>
                ${!proj.clientAcceptedFinal ? `
                  <button type="button" onclick="confirmClientFinalReceipt('${proj.id}')" class="btn-ghost-gold w-full py-2.5 rounded-xl text-xs font-bold">
                    ✓ Konfirmasi Penerimaan Hasil Akhir (Arsipkan)
                  </button>
                ` : `
                  <p class="text-center text-[11px] text-emerald-400 font-semibold">✓ Hasil akhir dikonfirmasi diterima &amp; diarsipkan.</p>
                `}
              ` : `
                <button type="button" disabled class="w-full py-3 rounded-xl bg-acoustic border border-borderline text-ash text-xs font-bold cursor-not-allowed">
                  🔒 Hasil Akhir Terkunci (Selesaikan Pembayaran / Pelunasan)
                </button>
              `}
            </div>
          </div>
        </div>
      `;
    }

    async function changeClientPaymentScheme(projId, scheme) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      proj.paymentScheme = scheme;
      proj.dpAmount = scheme === 'DP 50%' ? Math.round(proj.totalPrice * 0.5) : proj.totalPrice;
      proj.pelunasanStatus = scheme === 'Pembayaran Penuh 100%' ? 'Tidak Perlu (Skema Penuh)' : 'Belum Lunas';
      await syncProjectToCloud(proj);
      renderClientWorkspace();
    }

    function uploadClientStagePayment(projId, kind, file) {
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) {
        showToast('File Terlalu Besar', 'Maksimal ukuran file bukti transfer adalah 2 MB.', 'error');
        return;
      }
      const reader = new FileReader();
      reader.onload = async () => {
        const proj = appState.projects.find(p => p.id === projId);
        if (!proj) return;
        const cloudUrl = await uploadFileToFirebaseStorage(`payments/${projId}_${kind}_${Date.now()}_${file.name}`, file);
        const finalUrl = cloudUrl || reader.result;

        if (kind === 'dp') {
          proj.dpProofName = file.name;
          proj.dpProofDataUrl = finalUrl;
          proj.dpStatus = 'Menunggu Verifikasi';
          proj.dpRejectReason = '';
          proj.productionStatus = TRACKER_MILESTONES[3];
        } else {
          proj.pelunasanProofName = file.name;
          proj.pelunasanProofDataUrl = finalUrl;
          proj.pelunasanStatus = 'Menunggu Verifikasi';
        }
        await syncProjectToCloud(proj);
        renderClientWorkspace();
        showToast('Bukti Pembayaran Terkirim', 'Menunggu verifikasi Admin sebelum pekerjaan/rilis dilanjutkan.');
      };
      reader.readAsDataURL(file);
    }

    async function confirmClientFinalReceipt(projId) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      proj.clientAcceptedFinal = true;
      proj.productionStatus = TRACKER_MILESTONES[7];
      await syncProjectToCloud(proj);
      renderClientWorkspace();
      showToast('Pesanan Selesai & Diarsipkan', 'Terima kasih telah berkarya bersama PrangArt Studios.');
    }

    function downloadMasterAsset(projId) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      if (proj.masterFileUrl) {
        triggerPngFileDownload(proj.masterFileUrl, proj.masterFileName || `${proj.id}-MASTER.wav`);
      } else {
        showToast('Unduhan Master Dimulai', `Mengunduh berkas master resmi untuk ${proj.judul}.`);
      }
    }

    // -------------------------------------------------------------------------
    // PAGE 5: ADMIN STUDIO COMMAND CENTER
    // -------------------------------------------------------------------------
    function verifyAdminPin(e) {
      e.preventDefault();
      const pin = document.getElementById('admin-pin-input')?.value.trim();
      const validPin = appState.settings.adminPin || '2026';
      if (pin !== validPin) {
        showToast('PIN Salah', 'PIN Studio tidak sesuai.', 'error');
        return;
      }
      appState.isAdminAuthenticated = true;
      refreshAdminPageUI();
    }

    function refreshAdminPageUI() {
      const gate = document.getElementById('admin-pin-gate');
      const ws = document.getElementById('admin-workspace-content');
      if (!appState.isAdminAuthenticated) {
        gate?.classList.remove('hidden');
        ws?.classList.add('hidden');
        return;
      }
      gate?.classList.add('hidden');
      ws?.classList.remove('hidden');
      renderAdminDashboard();
    }

    function renderAdminDashboard() {
      const container = document.getElementById('admin-workspace-content');
      if (!container) return;

      const filtered = appState.adminFilterStatus === 'Semua'
        ? appState.projects
        : appState.projects.filter(p => p.productionStatus === appState.adminFilterStatus);

      if (!filtered.some(p => p.id === appState.selectedAdminProjectId) && filtered.length > 0) {
        appState.selectedAdminProjectId = filtered[0].id;
      }

      container.innerHTML = `
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-borderline pb-4">
          <div>
            <span class="text-xs font-mono uppercase text-gold font-bold">Panel Produser &amp; Komposer</span>
            <h2 class="text-2xl font-bold text-ivory">Pemeriksaan Brief, Penawaran &amp; Produksi</h2>
          </div>
          <div class="flex flex-wrap gap-1.5">
            ${['Semua', ...TRACKER_MILESTONES].map(st => `
              <button type="button" onclick="appState.adminFilterStatus = '${st}'; renderAdminDashboard()" class="px-2.5 py-1.5 rounded-lg text-[11px] font-semibold ${appState.adminFilterStatus === st ? 'bg-gold text-obsidian' : 'bg-charcoal text-ash border border-borderline'}">
                ${st}
              </button>
            `).join('')}
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
          <div class="lg:col-span-4 space-y-2.5">
            ${filtered.map(p => `
              <button type="button" onclick="appState.selectedAdminProjectId = '${p.id}'; renderAdminDashboard()" class="w-full text-left p-4 rounded-2xl border transition ${p.id === appState.selectedAdminProjectId ? 'bg-charcoal border-gold' : 'bg-charcoal/60 border-borderline hover:border-gold/40'}">
                <div class="flex items-center justify-between text-[11px] font-mono mb-1">
                  <span class="text-gold font-bold">${p.id}</span>
                  <span class="text-ash">${p.createdAt}</span>
                </div>
                <strong class="text-sm text-ivory block truncate">${p.judul}</strong>
                <span class="text-xs text-ash block truncate">${p.clientName} • ${p.instansi}</span>
                <div class="flex items-center justify-between mt-2 pt-2 border-t border-borderline text-[11px]">
                  <span class="text-emerald-400 font-semibold truncate max-w-[170px]">${p.productionStatus}</span>
                  <span class="font-mono text-ivory">${formatRupiah(p.totalPrice)}</span>
                </div>
              </button>
            `).join('')}
          </div>
          <div id="admin-inspector-panel" class="lg:col-span-8"></div>
        </div>

        <!-- Studio Settings & Portfolio Management -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-4">
            <h3 class="text-sm font-bold text-gold uppercase font-mono">Pengaturan Studio</h3>
            <div class="space-y-3 text-xs">
              <div>
                <label class="block text-ash mb-1">Rekening Tujuan Pembayaran</label>
                <input type="text" id="set-bank" value="${appState.settings.bankAccount}" class="w-full bg-acoustic border border-borderline rounded-xl px-3 py-2 text-ivory" />
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-ash mb-1">WhatsApp Produser (628...)</label>
                  <input type="text" id="set-wa" value="${appState.settings.studioWhatsApp}" class="w-full bg-acoustic border border-borderline rounded-xl px-3 py-2 font-mono text-ivory" />
                </div>
                <div>
                  <label class="block text-ash mb-1">PIN Akses Admin</label>
                  <input type="text" id="set-pin" value="${appState.settings.adminPin || '2026'}" class="w-full bg-acoustic border border-borderline rounded-xl px-3 py-2 font-mono text-ivory" />
                </div>
              </div>
              <button type="button" onclick="saveStudioSettings()" class="btn-gold px-4 py-2.5 rounded-xl text-xs font-bold">Simpan Pengaturan</button>
            </div>
          </div>

          <div class="bg-charcoal border border-borderline rounded-2xl p-5 space-y-4">
            <h3 class="text-sm font-bold text-gold uppercase font-mono">Kelola Portofolio Publik</h3>
            <form onsubmit="addPortfolioItem(event)" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs">
              <input type="text" id="pf-new-title" required placeholder="Judul karya..." class="bg-acoustic border border-borderline rounded-xl px-3 py-2 text-ivory" />
              <select id="pf-new-cat" class="bg-acoustic border border-borderline rounded-xl px-3 py-2 text-ivory">
                <option value="Produksi Musik Tari">Produksi Musik Tari</option>
                <option value="Produksi Musik Non-Tari">Produksi Musik Non-Tari</option>
                <option value="Transkripsi Musik">Transkripsi Musik</option>
              </select>
              <input type="text" id="pf-new-culture" required placeholder="Latar budaya / format..." class="bg-acoustic border border-borderline rounded-xl px-3 py-2 text-ivory" />
              <button type="submit" class="btn-ghost-gold rounded-xl py-2 font-bold">+ Tambah Karya</button>
            </form>
            <div class="space-y-1.5 max-h-36 overflow-y-auto">
              ${appState.portfolioItems.map((item, idx) => `
                <div class="flex items-center justify-between bg-acoustic rounded-lg px-3 py-2 text-xs">
                  <span><strong>${item.title}</strong> <span class="text-ash">(${item.category})</span></span>
                  <button type="button" onclick="removePortfolioItem(${idx})" class="text-red-400 hover:underline">Hapus</button>
                </div>
              `).join('')}
            </div>
          </div>
        </div>
      `;

      renderAdminInspector();
    }

    function renderAdminInspector() {
      const panel = document.getElementById('admin-inspector-panel');
      if (!panel) return;
      const proj = appState.projects.find(p => p.id === appState.selectedAdminProjectId);
      if (!proj) {
        panel.innerHTML = `<div class="bg-charcoal border border-borderline rounded-2xl p-8 text-center text-xs text-ash">Pilih proyek di sebelah kiri untuk memeriksa detail.</div>`;
        return;
      }

      panel.innerHTML = `
        <div class="bg-charcoal border border-borderline rounded-2xl p-5 sm:p-6 space-y-5">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b border-borderline pb-4">
            <div>
              <span class="text-xs font-mono text-gold font-bold">${proj.id} • ${proj.serviceLineLabel} (${proj.packageName})</span>
              <h3 class="text-xl font-bold text-ivory mt-0.5">${proj.judul}</h3>
              <p class="text-xs text-ash">${proj.clientName} (${proj.instansi}, ${proj.kota}) • ${proj.entryPath}</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <button type="button" onclick="openBriefCardModal('${proj.id}')" class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold">🎨 Kartu Brief</button>
              <button type="button" onclick="openContractDocModal('${proj.id}', false)" class="btn-ghost-gold px-3 py-2 rounded-xl text-xs font-bold">📜 Perjanjian</button>
              <button type="button" onclick="openOfficialDocModal('${proj.id}', 'invoice', 'dp')" class="btn-ghost-gold px-3 py-2 rounded-xl text-xs font-bold">📄 Invoice</button>
              <button type="button" onclick="openOfficialDocModal('${proj.id}', 'kuitansi', 'dp')" class="btn-ghost-gold px-3 py-2 rounded-xl text-xs font-bold">🧾 Kuitansi</button>
            </div>
          </div>

          <!-- Tahap 6: Penawaran Harga & Estimasi Pengerjaan -->
          <div class="bg-acoustic border border-gold/30 rounded-xl p-4 space-y-3">
            <div class="flex items-center justify-between">
              <strong class="text-xs text-gold uppercase font-mono">Tahap 6 • Penerbitan Penawaran Harga Resmi</strong>
              <span class="text-[11px] font-mono text-ivory">Status: ${proj.quoteStatus}</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs">
              <div>
                <label class="block text-[11px] text-ash mb-1">Biaya Final (Rp)</label>
                <input type="number" id="admin-quote-price" value="${proj.totalPrice}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 font-mono text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Estimasi Pengerjaan</label>
                <input type="text" id="admin-quote-days" value="${proj.quoteDurationDays || '7–10 Hari Kerja'}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory" />
              </div>
              <div>
                <label class="block text-[11px] text-ash mb-1">Hasil yang Diserahkan</label>
                <input type="text" id="admin-quote-deliver" value="${proj.quoteDeliverables || 'Audio Master WAV & MP3'}" class="w-full bg-obsidian border border-borderline rounded-lg px-3 py-2 text-ivory" />
              </div>
            </div>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <input type="text" id="admin-quote-notes" value="${proj.quoteNotes || ''}" placeholder="Catatan hasil diskusi (opsional)..." class="flex-1 bg-obsidian border border-borderline rounded-lg px-3 py-2 text-xs text-ivory" />
              <button type="button" onclick="issueOfficialQuotation('${proj.id}')" class="btn-gold px-4 py-2 rounded-xl text-xs font-bold shrink-0">
                📨 Terbitkan Penawaran Resmi
              </button>
            </div>
          </div>

          <!-- Stage Selector -->
          <div class="bg-acoustic border border-borderline rounded-xl p-4 space-y-2">
            <label class="block text-xs font-bold text-ivory">Tahapan Progres Saat Ini:</label>
            <select onchange="updateAdminProjectStage('${proj.id}', this.value)" class="w-full bg-obsidian border border-gold/40 rounded-xl px-3.5 py-2.5 text-xs font-bold text-gold">
              ${TRACKER_MILESTONES.map(st => `<option value="${st}" ${proj.productionStatus === st ? 'selected' : ''}>${st}</option>`).join('')}
            </select>
          </div>

          <!-- Payment Verification -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="bg-acoustic border border-borderline rounded-xl p-4 space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <strong>Termin I (${proj.paymentScheme})</strong>
                <span class="font-mono text-gold">${proj.dpStatus}</span>
              </div>
              <div class="flex flex-wrap gap-2">
                <button type="button" onclick="inspectPaymentProof('${proj.id}', 'dp')" class="px-2.5 py-1.5 rounded-lg bg-obsidian border border-borderline text-xs text-ivory hover:border-gold">👁 Lihat Bukti</button>
                <button type="button" onclick="verifyProjectPayment('${proj.id}', 'dp', 'Terverifikasi')" class="px-2.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold">✓ Sah</button>
                <button type="button" onclick="verifyProjectPayment('${proj.id}', 'dp', 'Ditolak')" class="px-2.5 py-1.5 rounded-lg bg-red-600 text-white text-xs font-bold">✕ Tolak</button>
              </div>
            </div>

            <div class="bg-acoustic border border-borderline rounded-xl p-4 space-y-2.5">
              <div class="flex items-center justify-between text-xs">
                <strong>Termin II: Pelunasan (${formatRupiah(proj.totalPrice - proj.dpAmount)})</strong>
                <span class="font-mono text-gold">${proj.pelunasanStatus}</span>
              </div>
              <div class="flex flex-wrap gap-2">
                <button type="button" onclick="inspectPaymentProof('${proj.id}', 'lunas')" class="px-2.5 py-1.5 rounded-lg bg-obsidian border border-borderline text-xs text-ivory hover:border-gold">👁 Lihat Bukti</button>
                <button type="button" onclick="verifyProjectPayment('${proj.id}', 'lunas', 'Lunas')" class="px-2.5 py-1.5 rounded-lg bg-emerald-600 text-white text-xs font-bold">✓ Sah Lunas</button>
              </div>
            </div>
          </div>

          <!-- Studio File Upload (Preview & Master) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <label class="bg-acoustic border border-dashed border-gold/40 hover:border-gold rounded-xl p-4 cursor-pointer text-xs space-y-1">
              <strong class="text-ivory block">🎧 Unggah Audio Pratinjau (MP3/WAV)</strong>
              <span class="text-ash block truncate">${proj.previewAudioName || 'Belum ada file pratinjau'}</span>
              <input type="file" accept="audio/*" onchange="uploadStudioDeliverable('${proj.id}', 'preview', this.files[0])" class="hidden" />
            </label>
            <label class="bg-acoustic border border-dashed border-emerald-500/40 hover:border-emerald-400 rounded-xl p-4 cursor-pointer text-xs space-y-1">
              <strong class="text-ivory block">💿 Unggah Hasil Akhir Master (WAV/ZIP/PDF)</strong>
              <span class="text-ash block truncate">${proj.masterFileName || 'Belum ada file master'}</span>
              <input type="file" onchange="uploadStudioDeliverable('${proj.id}', 'master', this.files[0])" class="hidden" />
            </label>
          </div>

          <!-- Brief Summary & Direct WA Client -->
          <div class="bg-obsidian border border-borderline rounded-xl p-4 space-y-2 text-xs">
            <strong class="text-gold block">Sinopsis &amp; Referensi Klien:</strong>
            <p class="text-ash leading-relaxed">${proj.sinopsis}</p>
            <p class="text-[11px] font-mono text-ivory truncate">Ref: ${proj.referensi}</p>
            <div class="pt-2 flex flex-wrap gap-2">
              <a href="https://wa.me/${proj.wa.replace(/^0/, '62')}?text=${encodeURIComponent(`Halo ${proj.clientName}, saya dari PrangArt Lab terkait karya "${proj.judul}" (${proj.id}). Penawaran resmi dan dokumen perjanjian sudah siap.`)}" target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold">
                💬 Hubungi WhatsApp Klien (${proj.wa})
              </a>
            </div>
          </div>
        </div>
      `;
    }

    async function issueOfficialQuotation(projId) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      const newTotal = Number(document.getElementById('admin-quote-price')?.value) || proj.totalPrice;
      proj.totalPrice = newTotal;
      proj.dpAmount = proj.paymentScheme === 'DP 50%' ? Math.round(newTotal * 0.5) : newTotal;
      proj.composerRole = document.getElementById('admin-composer-role')?.value || 'Composer & Arranger';
      proj.revisionQuota = document.getElementById('admin-quote-rev')?.value.trim() || '6';
      proj.deliverableFormat = document.getElementById('admin-quote-deliver')?.value.trim() || 'WAV 24-bit & MP3 320kbps';
      proj.quoteDurationDays = document.getElementById('admin-quote-days')?.value.trim() || '7–10 Hari Kerja';
      proj.collaboratorNotes = document.getElementById('admin-collab-notes')?.value.trim() || 'Tidak ada kontributor tambahan';
      proj.quoteDeliverables = `${proj.deliverableFormat} (${proj.revisionQuota}x revisi ringan)`;
      proj.quoteNotes = document.getElementById('admin-quote-notes')?.value.trim() || '';
      proj.quoteStatus = 'Diterbitkan';
      proj.productionStatus = TRACKER_MILESTONES[2];
      await syncProjectToCloud(proj);
      renderAdminDashboard();
      showToast('Penawaran & Perjanjian Diterbitkan', `Klien kini dapat menyetujui perjanjian & melakukan pembayaran.`);
    }

    async function issueOfficialQuotation(projId) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      const newTotal = Number(document.getElementById('admin-quote-price')?.value) || proj.totalPrice;
      proj.totalPrice = newTotal;
      proj.dpAmount = proj.paymentScheme === 'DP 50%' ? Math.round(newTotal * 0.5) : newTotal;
      proj.quoteDurationDays = document.getElementById('admin-quote-days')?.value.trim() || '7–10 Hari Kerja';
      proj.quoteDeliverables = document.getElementById('admin-quote-deliver')?.value.trim() || 'Audio Master WAV & MP3';
      proj.quoteNotes = document.getElementById('admin-quote-notes')?.value.trim() || '';
      proj.quoteStatus = 'Diterbitkan';
      proj.productionStatus = TRACKER_MILESTONES[2];
      await syncProjectToCloud(proj);
      renderAdminDashboard();
      showToast('Penawaran Diterbitkan', `Klien kini dapat menyetujui administrasi & melakukan pembayaran.`);
    }

    async function updateAdminProjectStage(projId, newStage) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      proj.productionStatus = newStage;
      await syncProjectToCloud(proj);
      renderAdminDashboard();
      showToast('Tahapan Diperbarui', `${proj.id} → ${newStage}`);
    }

    async function verifyProjectPayment(projId, kind, status) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      if (kind === 'dp') {
        proj.dpStatus = status;
        if (status === 'Terverifikasi') {
          proj.productionStatus = TRACKER_MILESTONES[4];
        }
        if (status === 'Ditolak') {
          proj.dpRejectReason = 'Bukti transfer belum terbaca / nominal belum sesuai. Silakan unggah ulang.';
        }
      } else {
        proj.pelunasanStatus = status;
        if (status === 'Lunas') {
          proj.productionStatus = TRACKER_MILESTONES[6];
        }
      }
      await syncProjectToCloud(proj);
      renderAdminDashboard();
      showToast('Status Pembayaran Diperbarui', `${proj.id}: ${status}`);
    }

    function inspectPaymentProof(projId, kind) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      const name = kind === 'dp' ? proj.dpProofName : proj.pelunasanProofName;
      const url = kind === 'dp' ? proj.dpProofDataUrl : proj.pelunasanProofDataUrl;
      document.getElementById('custom-modal-title').textContent = `Bukti Transfer (${kind === 'dp' ? 'Termin I' : 'Pelunasan'})`;
      document.getElementById('custom-modal-body').innerHTML = `
        <div class="space-y-3">
          <p class="font-mono text-gold">${name || 'Belum ada file terunggah'}</p>
          ${url && (url.startsWith('data:image') || url.startsWith('http'))
            ? `<img src="${url}" alt="Bukti Transfer" class="w-full max-h-96 object-contain rounded-xl border border-borderline bg-obsidian" />`
            : `<p class="text-ash">Pratinjau dokumen PDF/simulasi siap diverifikasi.</p>`
          }
        </div>
      `;
      const m = document.getElementById('custom-modal');
      m?.classList.remove('hidden');
      m?.classList.add('flex');
    }

    function closeCustomModal() {
      const m = document.getElementById('custom-modal');
      m?.classList.add('hidden');
      m?.classList.remove('flex');
    }

    function uploadStudioDeliverable(projId, kind, file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = async () => {
        const proj = appState.projects.find(p => p.id === projId);
        if (!proj) return;
        const cloudUrl = await uploadFileToFirebaseStorage(`deliverables/${projId}_${kind}_${Date.now()}_${file.name}`, file);
        const finalUrl = cloudUrl || reader.result;

        if (kind === 'preview') {
          proj.previewAudioName = file.name;
          proj.previewAudioUrl = finalUrl;
          proj.productionStatus = TRACKER_MILESTONES[5];
        } else {
          proj.masterFileName = file.name;
          proj.masterFileUrl = finalUrl;
        }
        await syncProjectToCloud(proj);
        renderAdminInspector();
        showToast('File Terunggah', `${file.name} berhasil dilampirkan ke ${proj.id}.`);
      };
      reader.readAsDataURL(file);
    }

    function saveStudioSettings() {
      appState.settings.bankAccount = document.getElementById('set-bank')?.value.trim() || appState.settings.bankAccount;
      appState.settings.studioWhatsApp = document.getElementById('set-wa')?.value.trim() || appState.settings.studioWhatsApp;
      appState.settings.adminPin = document.getElementById('set-pin')?.value.trim() || appState.settings.adminPin;
      syncStudioConfigToCloud();
      showToast('Pengaturan Tersimpan', 'Pengaturan studio diperbarui & tersinkron ke Cloud.');
    }

    function addPortfolioItem(e) {
      e.preventDefault();
      const title = document.getElementById('pf-new-title').value.trim();
      const category = document.getElementById('pf-new-cat').value;
      const culture = document.getElementById('pf-new-culture').value.trim();
      appState.portfolioItems.unshift({
        id: `PF-${Date.now()}`,
        title,
        category,
        culture,
        duration: '04:30',
        desc: `Karya ${category} oleh PrangArt Studios (${culture}).`,
        freq: 293.66
      });
      syncStudioConfigToCloud();
      renderAdminDashboard();
      showToast('Portofolio Ditambahkan', `"${title}" tampil di halaman Portofolio.`);
    }

    function removePortfolioItem(idx) {
      appState.portfolioItems.splice(idx, 1);
      syncStudioConfigToCloud();
      renderAdminDashboard();
    }

    // -------------------------------------------------------------------------
    // OFFICIAL PERJANJIAN PRODUKSI MUSIK PRANGART LAB (v4-8 + LAMPIRAN A, B, C)
    // -------------------------------------------------------------------------
    let activeContractDocData = null;

    function getCreditTextByRole(role, directorName) {
      const cleanName = String(directorName || 'Fikri Yassaar Arrazaq').split(',')[0].trim();
      if (role === 'Composer') return `Musik: ${cleanName}`;
      if (role === 'Arranger') return `Aransemen: ${cleanName}`;
      if (role === 'Tim produksi saja') return `Produksi musik: PrangArt Lab`;
      return `Musik dan aransemen: ${cleanName}`;
    }

    function buildContractDataFromProject(proj) {
      const dpNominal = proj.dpAmount || Math.round((proj.totalPrice || 0) * 0.5);
      const pelunasanNominal = (proj.totalPrice || 0) - dpNominal;
      const role = proj.composerRole || 'Composer & Arranger';
      return {
        nomorPerjanjian: proj.contractNumber || `${proj.id.replace('PAL-2026-', '')}/PAL-SPK/XI/2026`,
        tanggal: proj.createdAt || new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        pihak1Nama: appState.settings.directorName,
        pihak1Alamat: appState.settings.studioAddress,
        pihak1Nik: appState.settings.directorIdNumber || '6472050000000001',
        nama: proj.clientName || '........................................',
        sanggar: proj.instansi || '........................................',
        alamatKlien: proj.alamat || proj.kota || '........................................',
        nikKlien: proj.nik || '........................................',
        namaTari: proj.judul || '........................................',
        jenisKarya: proj.jenisTari || proj.serviceLineLabel || 'Karya Tari / Musik',
        judulBerkas: proj.musicFileTitle || `${(proj.judul || 'Karya').replace(/\s+/g, '_')}_Final`,
        estimasi: proj.durasi || '.... : ....',
        formatFile: proj.deliverableFormat || 'WAV / MP3',
        jumlahFormatted: Number(proj.totalPrice || 0).toLocaleString('id-ID') + ',00',
        jumlahTerbilang: `${numberToIndonesianWords(proj.totalPrice || 0)} Rupiah`,
        dpFormatted: formatRupiah(dpNominal),
        pelunasanFormatted: formatRupiah(pelunasanNominal),
        revisiJumlah: proj.revisionQuota || '6',
        kedudukan: role,
        formatKredit: getCreditTextByRole(role, appState.settings.directorName),
        materiPihakKetiga: proj.thirdPartyMaterial || 'Tidak ada',
        kolaborator: proj.collaboratorNotes || 'Tidak ada kontributor tambahan',
        berkasMentah: proj.rawFilesIncluded ? `Diserahkan: ${proj.rawFilesDetail}` : 'Tidak diserahkan',
        catatanTambahan: proj.extraAttachmentNotes || proj.quoteNotes || '-',
        kotaPengadilan: proj.courtCity || 'Samarinda',
        serviceLine: proj.serviceLine || 'tari',
        serviceLineLabel: proj.serviceLineLabel || 'Produksi Musik Tari',
        ticketId: proj.id || 'DRAFT'
      };
    }

    function openDraftContractPreviewModal() {
      const u = appState.currentClientUser || {};
      const svc = appState.serviceCatalog[appState.selectedServiceLine];
      const pkg = svc.packages[appState.selectedPackage];
      const addonChecked = Boolean(document.getElementById('field-addon-vocal')?.checked);
      const total = pkg.price + (addonChecked ? svc.addonPrice : 0);
      const defaultRev = appState.selectedPackage === 'dasar' ? '3' : appState.selectedPackage === 'standar' ? '6' : 'Sesuai kesepakatan';

      const draftProj = {
        id: 'DRAFT',
        createdAt: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        clientName: document.getElementById('field-nama')?.value.trim() || u.name || '........................................',
        instansi: document.getElementById('field-instansi')?.value.trim() || u.instansi || '........................................',
        alamat: document.getElementById('field-alamat')?.value.trim() || u.alamat || '........................................',
        nik: document.getElementById('field-nik')?.value.trim() || u.nik || '........................................',
        judul: document.getElementById('field-judul')?.value.trim() || '........................................',
        jenisTari: document.getElementById('field-jenis-tari')?.value.trim() || svc.label,
        durasi: document.getElementById('field-durasi')?.value.trim() || '05:00',
        totalPrice: total,
        dpAmount: Math.round(total * 0.5),
        revisionQuota: defaultRev,
        serviceLine: appState.selectedServiceLine,
        serviceLineLabel: svc.label
      };
      activeContractDocData = buildContractDataFromProject(draftProj);
      renderContractDocumentCanvas();
      document.getElementById('contract-sign-footer')?.classList.add('hidden');
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function openContractDocModal(projId, enableSigning = false) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      activeContractDocData = buildContractDataFromProject(proj);
      renderContractDocumentCanvas();
      const footer = document.getElementById('contract-sign-footer');
      const cb = document.getElementById('sign-agreement-cb');
      const addrInp = document.getElementById('sign-client-address');
      const nikInp = document.getElementById('sign-client-nik');
      if (cb) cb.checked = false;
      if (addrInp) addrInp.value = proj.alamat || proj.kota || '';
      if (nikInp) nikInp.value = proj.nik || '';
      if (footer) {
        if (enableSigning && !proj.agreementSigned) {
          footer.classList.remove('hidden');
          footer.classList.add('flex');
        } else {
          footer.classList.add('hidden');
          footer.classList.remove('flex');
        }
      }
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeContractDocModal() {
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    async function confirmClientAdministrativeApproval() {
      const cb = document.getElementById('sign-agreement-cb');
      if (!cb?.checked) {
        showToast('Centang Persetujuan', 'Centang kotak persetujuan perjanjian terlebih dahulu.', 'warning');
        return;
      }
      const proj = appState.projects.find(p => p.id === activeContractDocData?.ticketId);
      if (!proj) return;
      const addrVal = document.getElementById('sign-client-address')?.value.trim();
      const nikVal = document.getElementById('sign-client-nik')?.value.trim();
      if (addrVal) proj.alamat = addrVal;
      if (nikVal) proj.nik = nikVal;

      proj.agreementSigned = true;
      proj.agreementSignedAt = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      proj.productionStatus = TRACKER_MILESTONES[3];
      await syncProjectToCloud(proj);
      closeContractDocModal();
      renderClientWorkspace();
      showToast('Perjanjian Disetujui', 'Tahap pembayaran telah dibuka untuk pesanan Anda.');
    }

    function renderContractDocumentCanvas() {
      const d = activeContractDocData;
      const canvasEl = document.getElementById('contract-doc-canvas');
      const headingEl = document.getElementById('contract-modal-heading');
      if (!d || !canvasEl) return;

      const isTranskripsi = d.serviceLine === 'transkripsi';
      const docMainTitle = isTranskripsi
        ? 'PERSETUJUAN PENAWARAN & KETENTUAN TRANSKRIPSI MUSIK'
        : 'PERJANJIAN PRODUKSI MUSIK';

      if (headingEl) headingEl.textContent = `${docMainTitle} — PrangArt Lab`;

      const checkMark = (target) => (d.kedudukan === target ? '[ ✓ ]' : '[   ]');
      const isNoCollab = d.kolaborator.toLowerCase().includes('tidak ada');

      canvasEl.innerHTML = `
        <div class="space-y-5 text-neutral-900 text-xs sm:text-[13px] leading-relaxed">
          <!-- Header -->
          <div class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-neutral-900 pb-4">
            <div class="flex items-center gap-3">
              <img src="${LOGO_URL}" alt="PrangArt Lab" class="w-14 h-14 object-contain" />
              <div>
                <p class="text-xs font-bold tracking-widest uppercase">PRANGART LAB</p>
                <h2 class="text-lg sm:text-xl font-bold uppercase">${docMainTitle}</h2>
                <p class="text-xs">Nomor: <strong>${d.nomorPerjanjian}</strong> &nbsp;|&nbsp; Tanggal: <strong>${d.tanggal}</strong></p>
              </div>
            </div>
          </div>

          <!-- Para Pihak Table -->
          <table class="w-full border-collapse border border-neutral-900 text-xs">
            <tbody>
              <tr class="border-b border-neutral-900">
                <td class="border-r border-neutral-900 p-3 font-bold w-40 align-top bg-neutral-100">PIHAK PERTAMA</td>
                <td class="p-3 space-y-0.5">
                  <p>Nama: <strong>${d.pihak1Nama}</strong></p>
                  <p>Kedudukan dalam karya ini: sebagaimana Lampiran A (<em>${d.kedudukan}</em>)</p>
                  <p>Pemilik usaha <strong>PrangArt Lab</strong></p>
                  <p>Alamat: ${d.pihak1Alamat}</p>
                  <p>Nomor Identitas: ${d.pihak1Nik}</p>
                </td>
              </tr>
              <tr>
                <td class="border-r border-neutral-900 p-3 font-bold align-top bg-neutral-100">PIHAK KEDUA</td>
                <td class="p-3 space-y-0.5">
                  <p>Nama: <strong>${d.nama}</strong></p>
                  <p>Instansi/Sanggar/Komunitas/Individu: <strong>${d.sanggar}</strong></p>
                  <p>Alamat: ${d.alamatKlien}</p>
                  <p>Nomor Identitas: ${d.nikKlien}</p>
                </td>
              </tr>
            </tbody>
          </table>

          <p>Para Pihak sepakat mengikatkan diri dengan ketentuan berikut.</p>

          <!-- RINGKASAN KESEPAKATAN -->
          <div class="space-y-1.5">
            <h3 class="font-bold uppercase text-sm">RINGKASAN KESEPAKATAN</h3>
            <p class="text-[11px] italic text-neutral-600">Ringkasan ini memudahkan membaca isi perjanjian. Jika ada perbedaan dengan pasal-pasal, pasal yang berlaku.</p>
            <table class="w-full border-collapse border border-neutral-900 text-xs">
              <tbody>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold w-52 bg-neutral-50">Karya</td><td class="p-2"><strong>${d.namaTari}</strong> (${d.jenisKarya}), judul berkas <strong>${d.judulBerkas}</strong></td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Yang dikerjakan</td><td class="p-2">Sesuai kedudukan PIHAK PERTAMA di Lampiran A (${d.kedudukan}): komposisi, aransemen, produksi audio, mixing, dan/atau mastering</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">File yang diterima</td><td class="p-2">${d.formatFile}, durasi estimasi <strong>${d.estimasi}</strong> menit</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Harga</td><td class="p-2"><strong>Rp${d.jumlahFormatted}</strong> (<em>${d.jumlahTerbilang}</em>), sudah termasuk pengalihan hak ekonomi</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Pembayaran</td><td class="p-2">50% (${d.dpFormatted}) sebelum produksi dimulai, 50% (${d.pelunasanFormatted}) setelah draf final disetujui dan sebelum file final diserahkan</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Revisi</td><td class="p-2"><strong>${d.revisiJumlah}</strong> kali revisi ringan</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Hak yang diterima PIHAK KEDUA</td><td class="p-2">Seluruh hak ekonomi atas musik ini, dialihkan otomatis setelah pelunasan dan penyerahan file final</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Persetujuan pengalihan</td><td class="p-2">Dengan menandatangani perjanjian ini, PIHAK KEDUA menyetujui pengalihan otomatis tersebut, tanpa tanda tangan tambahan</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Pencatatan HKI</td><td class="p-2">PrangArt Lab dapat mencatatkan karya sesuai kedudukan Pencipta di Lampiran A. Klien dapat dicatat sebagai pemegang hak ekonomi setelah pengalihan berlaku</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Kredit</td><td class="p-2"><strong>"${d.formatKredit}"</strong> (lihat Pasal 4 ayat 1)</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Portofolio</td><td class="p-2">PrangArt Lab tetap berhak menampilkan karya ini sebagai portofolio</td></tr>
                <tr><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Tidak termasuk</td><td class="p-2">File mentah, multitrack, sesi DAW, dan preset, kecuali tercantum di Lampiran A</td></tr>
              </tbody>
            </table>
          </div>

          <!-- PASAL 1 - 9 -->
          <div class="space-y-3.5 pt-2">
            <div>
              <h4 class="font-bold uppercase">PASAL 1 — OBJEK DAN PENYERAHAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK PERTAMA melaksanakan pekerjaan sesuai kedudukannya di Lampiran A, berupa komposisi, aransemen, produksi audio, mixing, dan/atau mastering untuk karya yang diuraikan di Lampiran A, sesuai konsep yang disepakati secara tertulis sebelum produksi dimulai.</li>
                <li>PIHAK PERTAMA menyerahkan berkas final sesuai Lampiran A. Berkas proyek mentah, multitrack, sesi DAW, dan preset tidak diserahkan kecuali dicantumkan secara tegas di Lampiran A.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 2 — HARGA DAN PEMBAYARAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Harga keseluruhan adalah <strong>Rp${d.jumlahFormatted}</strong> (<em>${d.jumlahTerbilang}</em>). Harga ini sudah termasuk pekerjaan produksi dan pengalihan hak ekonomi sesuai Pasal 3.</li>
                <li>Pembayaran dilakukan dalam dua termin: (a) 50% sebelum produksi dimulai; dan (b) 50% setelah draf final disetujui dan sebelum file final diserahkan.</li>
                <li>Apabila PIHAK KEDUA membatalkan setelah produksi dimulai, pembayaran atas pekerjaan dan biaya yang telah dikeluarkan tetap berlaku secara proporsional sesuai progres.</li>
                <li>Perubahan konsep atau pekerjaan di luar kesepakatan awal dikenakan biaya tambahan setelah disetujui secara tertulis oleh Para Pihak.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 3 — PENGALIHAN HAK EKONOMI</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Dengan menandatangani perjanjian ini, PIHAK KEDUA menyetujui pengalihan hak ekonomi sebagaimana diatur dalam pasal ini. Persetujuan ini merupakan perjanjian tertulis mengenai pengalihan hak, dan tidak diperlukan konfirmasi atau tanda tangan tambahan pada saat pelunasan.</li>
                <li>Setelah pembayaran lunas diterima PIHAK PERTAMA dan file final diserahkan, hak ekonomi PIHAK PERTAMA atas komposisi/aransemen musik, sepanjang dimiliki sesuai kedudukannya, dialihkan secara otomatis kepada PIHAK KEDUA. Sepanjang PIHAK PERTAMA merupakan pemegang hak yang sah, hak ekonomi atas rekaman master final yang dibuat untuk pesanan ini juga dialihkan kepada PIHAK KEDUA dengan cara yang sama.</li>
                <li>Hak ekonomi yang dialihkan meliputi penggandaan, penerbitan, pengadaptasian, pengaransemenan, pendistribusian, pertunjukan, pengumuman, komunikasi kepada publik, dan penyewaan. PIHAK KEDUA berwenang memanfaatkannya untuk kepentingan pribadi, kelembagaan, maupun komersial, termasuk memberikan izin atau lisensi kepada pihak lain, tanpa persetujuan tambahan dari PIHAK PERTAMA.</li>
                <li>Selama hak tersebut berada pada PIHAK KEDUA, PIHAK PERTAMA tidak memberikan lisensi atau mengeksploitasi secara komersial hak yang sama, kecuali dengan persetujuan tertulis PIHAK KEDUA.</li>
                <li>Para Pihak memahami bahwa Pasal 18 Undang-Undang Nomor 28 Tahun 2014 tentang Hak Cipta mengatur bahwa untuk pengalihan lagu dan/atau musik tanpa batas waktu, Hak Cipta beralih kembali kepada Pencipta setelah 25 (dua puluh lima) tahun. Ketentuan pengalihan ini tidak dimaksudkan mengesampingkan ketentuan wajib tersebut.</li>
                <li>Pengalihan hak ekonomi tidak mencakup hak moral Pencipta, materi pihak ketiga yang tidak dikuasai sah oleh PIHAK PERTAMA, maupun hak kolaborator yang diatur dalam Pasal 5.</li>
                <li>Dengan menandatangani perjanjian ini, PIHAK KEDUA menyetujui bahwa PIHAK PERTAMA dapat mencatatkan karya ini ke Direktorat Jenderal Kekayaan Intelektual atas nama PIHAK PERTAMA, sesuai kedudukannya sebagai Pencipta untuk bagian yang benar-benar diciptakannya, tanpa konfirmasi tambahan dari PIHAK KEDUA. Setelah pengalihan berlaku sesuai ayat (2), PIHAK KEDUA dapat mencatatkan perubahan pemegang hak ekonomi dengan dokumen perjanjian ini, dan PIHAK PERTAMA bersedia memberikan dokumen yang secara wajar diperlukan. Apabila terdapat kolaborator sebagai Pencipta bersama, pencatatan mengikuti Lampiran B. Biaya pencatatan ditanggung pihak yang mengajukan.</li>
                <li>Apabila PIHAK PERTAMA hanya berkedudukan sebagai tim produksi, yang dialihkan adalah hak atas rekaman master dan hak lain yang dimiliki PIHAK PERTAMA. Hak ekonomi atas komposisi hanya dialihkan jika pencipta komposisi telah mengalihkannya kepada PIHAK PERTAMA, yang dibuktikan dengan Lampiran C.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 4 — KREDIT DAN HAK MORAL</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Format kredit mengikuti kedudukan PIHAK PERTAMA di Lampiran A: (a) Composer: “Musik: Fikri Yassaar Arrazaq”; (b) Arranger: “Aransemen: Fikri Yassaar Arrazaq”; (c) Composer &amp; Arranger: “Musik dan aransemen: Fikri Yassaar Arrazaq”; atau (d) tim produksi: “Produksi musik: PrangArt Lab”. Nama tanpa gelar. Nama PrangArt Lab merupakan identitas studio, bukan pengganti nama Pencipta.</li>
                <li>PIHAK KEDUA mengupayakan pencantuman kredit tersebut secara wajar dan konsisten, dengan tetap memperhatikan hak moral Pencipta sesuai peraturan perundang-undangan.</li>
                <li>PIHAK KEDUA tidak boleh dicantumkan sebagai Pencipta karya ini, dan tidak boleh menyatakan dirinya atau pihak lain sebagai Pencipta. PIHAK KEDUA dapat dicantumkan sebagai pemesan, atau sebagai pemegang hak ekonomi, dan pencantuman sebagai pemegang hak ekonomi hanya berlaku setelah pengalihan berlaku sesuai Pasal 3 ayat (2).</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 5 — KOLABORASI</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Apabila dalam produksi terdapat kolaborator (musisi, penyanyi, arranger tambahan, atau pihak lain yang memberikan kontribusi kreatif), kolaborator tersebut dicatat di Lampiran B dan kontribusinya diatur dalam Lampiran C.</li>
                <li>Hak ekonomi atas kontribusi kolaborator hanya dialihkan sejauh PIHAK PERTAMA memiliki kewenangan tertulis untuk itu. Jika belum ada, bagian tersebut diganti, ditunda, atau diberikan lisensi terbatas yang dinyatakan secara tegas sebelum penyerahan final.</li>
                <li>Pemanfaatan hak ekonomi oleh PIHAK KEDUA dapat dilakukan bersama kolaborator sebagaimana dicatat di Lampiran B.</li>
                <li>Apabila tidak ada kolaborator, Lampiran B diisi “Tidak ada kontributor tambahan”.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 6 — MATERI PIHAK KETIGA</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Sample, loop, sample library, plugin, atau instrumen virtual hanya digunakan sesuai lisensinya. Pembelian atau akses suatu library tidak otomatis mengalihkan hak cipta atas sampel atau instrumen tersebut.</li>
                <li>PIHAK PERTAMA memberitahukan secara tertulis kepada PIHAK KEDUA apabila terdapat materi berlisensi dengan batasan, seperti larangan distribusi sebagai file tersendiri atau kewajiban atribusi. Batasan tersebut tetap berlaku dan tidak termasuk dalam pengalihan.</li>
                <li>Materi yang disediakan sendiri oleh PIHAK KEDUA menjadi tanggung jawab PIHAK KEDUA untuk memastikan izinnya.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 7 — PORTOFOLIO</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK PERTAMA berhak mengunggah dan menampilkan karya ini sebagai portofolio dan promosi PrangArt Lab, berupa cuplikan musik, nama karya, dan materi terkait. Hak ini merupakan hak PIHAK PERTAMA dan tidak termasuk dalam pengalihan hak ekonomi.</li>
                <li>Penggunaan portofolio tetap memperhatikan hak pihak ketiga, informasi rahasia, dan data pribadi.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 8 — REVISI DAN PERNYATAAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK KEDUA berhak atas <strong>${d.revisiJumlah}</strong> kali revisi ringan selama tetap dalam konsep dan spesifikasi yang disepakati. Perubahan konsep dasar atau penambahan di luar kesepakatan dikenakan biaya tambahan dan wajib disetujui tertulis oleh PIHAK KEDUA sebelum dikerjakan.</li>
                <li>PIHAK PERTAMA menyatakan bahwa sepanjang pengetahuannya, bagian yang dibuatnya sendiri merupakan hasil kreativitasnya dan tidak dengan sengaja melanggar hak pihak lain.</li>
                <li>PIHAK KEDUA bertanggung jawab atas legalitas materi, referensi, lirik, atau rekaman yang disediakannya untuk dimasukkan ke dalam musik.</li>
                <li>Apabila timbul klaim pihak ketiga, pihak yang mengetahuinya wajib memberitahukan secara tertulis, dan Para Pihak bekerja sama menyelesaikannya sesuai sumber klaim dan hukum yang berlaku.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold uppercase">PASAL 9 — PENYELESAIAN PERSELISIHAN DAN PENUTUP</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Perselisihan diselesaikan terlebih dahulu melalui musyawarah. Jika tidak tercapai kesepakatan, Para Pihak dapat menempuh jalur hukum dengan domisili pada Pengadilan Negeri <strong>${d.kotaPengadilan}</strong>.</li>
                <li>Perjanjian berlaku sejak ditandatangani. Pengalihan hak ekonomi efektif setelah syarat Pasal 3 ayat (2) terpenuhi.</li>
                <li>Setiap perubahan hanya berlaku jika dibuat secara tertulis dan disetujui Para Pihak. Lampiran A, B, dan C merupakan bagian yang tidak terpisahkan dari perjanjian ini.</li>
                <li>Ketentuan yang bertentangan dengan hukum yang bersifat wajib tidak berlaku, dan ketentuan lainnya tetap berlaku sepanjang dapat dipisahkan.</li>
                <li>Perjanjian dibuat dalam 2 (dua) rangkap yang masing-masing mempunyai kekuatan hukum yang sama.</li>
              </ol>
            </div>
          </div>

          <!-- Signature Block -->
          <div class="pt-4">
            <p>Dibuat dan ditandatangani di: <strong>${d.kotaPengadilan}</strong> &nbsp;|&nbsp; Pada tanggal: <strong>${d.tanggal}</strong></p>
            <table class="w-full border-collapse border border-neutral-900 text-center mt-2 text-xs">
              <thead>
                <tr class="border-b border-neutral-900 bg-neutral-100">
                  <th class="border-r border-neutral-900 p-2 w-1/2">PIHAK PERTAMA</th>
                  <th class="p-2 w-1/2">PIHAK KEDUA</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="border-r border-neutral-900 p-3 pt-16">
                    <p class="font-bold underline">${d.pihak1Nama}</p>
                    <p>PrangArt Lab</p>
                  </td>
                  <td class="p-3 pt-16">
                    <p class="font-bold underline">${d.nama}</p>
                    <p>${d.sanggar}</p>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- LAMPIRAN A -->
          <div class="border-t-2 border-neutral-900 pt-5 space-y-2">
            <h3 class="font-bold uppercase text-sm">LAMPIRAN A — IDENTITAS KARYA DAN RINCIAN PENYERAHAN</h3>
            <table class="w-full border-collapse border border-neutral-900 text-xs">
              <tbody>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold w-52 bg-neutral-50">Judul karya</td><td class="p-2 font-bold">${d.namaTari}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Jenis karya</td><td class="p-2">${d.jenisKarya}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Kedudukan PIHAK PERTAMA</td><td class="p-2 font-mono text-[11px]">${checkMark('Composer')} Composer &nbsp; ${checkMark('Arranger')} Arranger &nbsp; ${checkMark('Composer & Arranger')} Composer &amp; Arranger &nbsp; ${checkMark('Tim produksi saja')} Tim produksi saja</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Judul berkas musik</td><td class="p-2 font-mono">${d.judulBerkas}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Tanggal penyelesaian</td><td class="p-2">${d.tanggal} (sesuai jadwal penawaran)</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Durasi</td><td class="p-2">${d.estimasi} menit</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Format file yang diserahkan</td><td class="p-2">${d.formatFile}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Materi pihak ketiga</td><td class="p-2">${d.materiPihakKetiga}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Kolaborator</td><td class="p-2">${d.kolaborator}</td></tr>
                <tr class="border-b border-neutral-900"><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Berkas mentah/multitrack</td><td class="p-2">${d.berkasMentah}</td></tr>
                <tr><td class="border-r border-neutral-900 p-2 font-semibold bg-neutral-50">Catatan tambahan</td><td class="p-2">${d.catatanTambahan}</td></tr>
              </tbody>
            </table>
          </div>

          <!-- LAMPIRAN B -->
          <div class="pt-3 space-y-2">
            <h3 class="font-bold uppercase text-sm">LAMPIRAN B — DAFTAR KOLABORATOR</h3>
            <p class="text-[11px] italic text-neutral-600">${isNoCollab ? 'Tidak ada kontributor tambahan.' : d.kolaborator}</p>
            <table class="w-full border-collapse border border-neutral-900 text-xs">
              <thead>
                <tr class="border-b border-neutral-900 bg-neutral-100">
                  <th class="border-r border-neutral-900 p-1.5 w-10">No.</th>
                  <th class="border-r border-neutral-900 p-1.5">Nama &amp; identitas</th>
                  <th class="border-r border-neutral-900 p-1.5">Peran/kredit</th>
                  <th class="border-r border-neutral-900 p-1.5">Uraian kontribusi</th>
                  <th class="p-1.5">Status dokumen</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-neutral-900">
                  <td class="border-r border-neutral-900 p-1.5 text-center">1</td>
                  <td class="border-r border-neutral-900 p-1.5">${isNoCollab ? 'Tidak ada kontributor tambahan' : d.kolaborator}</td>
                  <td class="border-r border-neutral-900 p-1.5">-</td>
                  <td class="border-r border-neutral-900 p-1.5">-</td>
                  <td class="p-1.5">-</td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- LAMPIRAN C -->
          <div class="pt-3 space-y-2 border-t border-dashed border-neutral-400">
            <h3 class="font-bold uppercase text-sm">LAMPIRAN C — FORMULIR KOLABORATOR</h3>
            <p class="text-[11px] text-neutral-700">Formulir ini dibuat untuk setiap kolaborator dan ditandatangani sebelum kontribusinya digunakan.</p>
            <div class="border border-neutral-900 p-3 space-y-1.5 text-xs">
              <p><strong>PENGELOLA PROYEK:</strong> ${d.pihak1Nama}, penyedia jasa dengan identitas usaha <strong>PrangArt Lab</strong>.</p>
              <p><strong>KOLABORATOR:</strong> ........................................, alamat ........................................, nomor identitas ........................................</p>
              <p><strong>Peran/kredit:</strong> ☐ Composer &nbsp; ☐ Arranger &nbsp; ☐ Composer &amp; Arranger &nbsp; ☐ Additional Composer &nbsp; ☐ Additional Arranger &nbsp; ☐ Collaborator</p>
              <p>1. KOLABORATOR menyatakan bahwa kontribusinya merupakan hasil pekerjaannya sendiri atau telah memperoleh izin yang diperlukan.</p>
              <p>2. Sepanjang hak ekonominya dapat dialihkan menurut hukum, KOLABORATOR mengalihkan kepada PENGELOLA PROYEK hak ekonomi atas kontribusi tersebut, untuk selanjutnya dialihkan kepada PIHAK KEDUA sesuai Pasal 3 perjanjian produksi ini.</p>
              <p>3. Pengalihan tidak mencakup hak moral KOLABORATOR sebagai Pencipta, hak pihak ketiga, maupun materi yang tidak dikuasai sah olehnya.</p>
            </div>
          </div>
        </div>
      `;
    }

    function downloadContractDocPNG() {
      const d = activeContractDocData;
      if (!d) return;
      const c = document.createElement('canvas');
      c.width = 1240;
      c.height = 1754;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);
      ctx.fillStyle = '#171717';

      ctx.font = 'bold 20px Georgia, serif';
      ctx.textAlign = 'center';
      ctx.fillText('PRANGART LAB', 620, 65);
      ctx.font = 'bold 26px Georgia, serif';
      ctx.fillText('PERJANJIAN PRODUKSI MUSIK', 620, 98);
      ctx.font = '17px Georgia, serif';
      ctx.fillText(`Nomor: ${d.nomorPerjanjian}   |   Tanggal: ${d.tanggal}`, 620, 126);

      ctx.beginPath(); ctx.moveTo(80, 144); ctx.lineTo(1160, 144); ctx.stroke();

      ctx.textAlign = 'left';
      let y = 176;
      const lh = 23;

      const writeLine = (txt, bold = false) => {
        ctx.font = `${bold ? 'bold ' : ''}16px Georgia, serif`;
        wrapCanvasText(ctx, txt, 1080).forEach(line => {
          ctx.fillText(line, 80, y);
          y += lh;
        });
      };

      writeLine(`PIHAK PERTAMA: ${d.pihak1Nama} (Pemilik usaha PrangArt Lab • Kedudukan: ${d.kedudukan})`, true);
      writeLine(`Alamat: ${d.pihak1Alamat} | No. Identitas: ${d.pihak1Nik}`);
      writeLine(`PIHAK KEDUA: ${d.nama} — ${d.sanggar}`, true);
      writeLine(`Alamat: ${d.alamatKlien} | No. Identitas: ${d.nikKlien}`);
      y += 6;
      writeLine(`RINGKASAN & PASAL 1 (Objek): Karya "${d.namaTari}" (${d.jenisKarya}), berkas ${d.judulBerkas}, durasi ${d.estimasi} menit, format ${d.formatFile}. Berkas mentah/multitrack: ${d.berkasMentah}.`);
      y += 5;
      writeLine(`PASAL 2 (Harga & Pembayaran): Rp${d.jumlahFormatted} (${d.jumlahTerbilang}), sudah termasuk pengalihan hak ekonomi. Termin I: 50% (${d.dpFormatted}), Termin II: 50% (${d.pelunasanFormatted}).`);
      y += 5;
      writeLine(`PASAL 3 (Pengalihan Hak Ekonomi): Setelah pembayaran lunas diterima PIHAK PERTAMA dan file final diserahkan, seluruh hak ekonomi dialihkan otomatis kepada PIHAK KEDUA tanpa tanda tangan tambahan (tunduk pada Pasal 18 UU No. 28 Tahun 2014 tentang Hak Cipta).`);
      y += 5;
      writeLine(`PASAL 4 (Kredit & Hak Moral): Format kredit wajib dicantumkan: "${d.formatKredit}" (nama tanpa gelar).`);
      y += 5;
      writeLine(`PASAL 5, 6, 7 (Kolaborasi, Materi Pihak Ketiga & Portofolio): Kolaborator: ${d.kolaborator}. Materi pihak ketiga: ${d.materiPihakKetiga}. PrangArt Lab berhak menampilkan cuplikan karya sebagai portofolio.`);
      y += 5;
      writeLine(`PASAL 8 & 9 (Revisi & Penutup): ${d.revisiJumlah} kali revisi ringan sesuai konsep awal. Domisili penyelesaian perselisihan: Pengadilan Negeri ${d.kotaPengadilan}. Lampiran A, B, dan C merupakan bagian tidak terpisahkan.`);

      const sigY = Math.max(y + 50, 1480);
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px Georgia, serif';
      ctx.fillText('PIHAK PERTAMA', 320, sigY);
      ctx.fillText(d.pihak1Nama, 320, sigY + 125);
      ctx.fillText('PrangArt Lab', 320, sigY + 150);

      ctx.fillText('PIHAK KEDUA', 920, sigY);
      ctx.fillText(d.nama, 920, sigY + 125);
      ctx.fillText(d.sanggar, 920, sigY + 150);

      triggerPngFileDownload(c.toDataURL('image/png'), `Perjanjian-PrangArtLab-${d.ticketId}.png`);
      showToast('Dokumen Diunduh', 'Perjanjian Produksi Musik PrangArt Lab siap dikirim.');
    }

    function openOfficialDocModal(projectId, docType = 'invoice', stage = 'dp') {
      appState.docModalState = { projectId, docType, stage };
      const stageSel = document.getElementById('doc-stage-select');
      if (stageSel) stageSel.value = stage;
      renderOfficialDocument();
      const modal = document.getElementById('official-doc-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeOfficialDocModal() {
      const modal = document.getElementById('official-doc-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    function switchOfficialDocType(docType) {
      appState.docModalState.docType = docType;
      renderOfficialDocument();
    }

    function switchOfficialDocStage(stage) {
      appState.docModalState.stage = stage;
      renderOfficialDocument();
    }

    function getOfficialDocComputedData() {
      const { projectId, docType, stage } = appState.docModalState;
      const proj = appState.projects.find(p => p.id === projectId);
      if (!proj) return null;
      const pelunasanAmt = proj.totalPrice - proj.dpAmount;
      const amount = stage === 'dp' ? proj.dpAmount : stage === 'lunas' ? pelunasanAmt : proj.totalPrice;
      const stageLabel =
        stage === 'dp'
          ? `Uang Muka / DP 50% — ${proj.serviceLineLabel} "${proj.judul}" (${proj.packageName})`
          : stage === 'lunas'
            ? `Pelunasan Musik — ${proj.serviceLineLabel} "${proj.judul}" (${proj.packageName})`
            : `Pembayaran Penuh 100% — ${proj.serviceLineLabel} "${proj.judul}" (${proj.packageName})`;

      return {
        proj,
        docType,
        stage,
        amount,
        amountFormatted: formatRupiah(amount) + ',00',
        terbilang: `${numberToIndonesianWords(amount)} Rupiah`,
        description: stageLabel,
        docNumber: `${docType === 'invoice' ? 'INV' : 'KWT'}/${proj.id}/${stage.toUpperCase()}`,
        dateText: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
      };
    }

    function renderOfficialDocument() {
      const data = getOfficialDocComputedData();
      const canvasEl = document.getElementById('official-doc-canvas');
      if (!data || !canvasEl) return;

      const invBtn = document.getElementById('doc-type-invoice');
      const kwtBtn = document.getElementById('doc-type-kuitansi');
      if (data.docType === 'invoice') {
        invBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold bg-gold text-obsidian';
        kwtBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-acoustic text-ash border border-borderline';
      } else {
        kwtBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-bold bg-gold text-obsidian';
        invBtn.className = 'px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-acoustic text-ash border border-borderline';
      }

      if (data.docType === 'invoice') {
        canvasEl.innerHTML = `
          <div class="relative font-serif text-neutral-900 space-y-6 p-2">
            <div class="flex items-start justify-between gap-4">
              <div class="flex flex-col items-center">
                <img src="${LOGO_URL}" alt="PrangArt Lab" class="w-16 h-16 object-contain" />
                <strong class="text-xs mt-1">PrangArt Lab</strong>
              </div>
              <h1 class="text-4xl sm:text-5xl font-normal tracking-tight">Invoice</h1>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm pt-2">
              <div class="space-y-0.5">
                <p>Jl. Wiraguna Gang 4</p>
                <p>Kel. Sidodadi, Samarinda</p>
                <p class="text-xs">Email : ${appState.settings.studioEmail}</p>
                <p class="text-xs">WhatsApp: 08977230597</p>
              </div>
              <div class="sm:text-right space-y-1">
                <p><strong>No:</strong> ${data.docNumber}</p>
                <p><strong>Tanggal:</strong> ${data.dateText}</p>
                <p><strong>Nama:</strong> ${data.proj.clientName} (${data.proj.instansi})</p>
              </div>
            </div>

            <table class="w-full border-collapse border border-neutral-900 text-sm">
              <thead>
                <tr class="border-b border-neutral-900">
                  <th class="border-r border-neutral-900 p-3 text-center font-normal w-2/3">Deskripsi</th>
                  <th class="p-3 text-center font-bold w-1/3">Jumlah</th>
                </tr>
              </thead>
              <tbody>
                <tr class="border-b border-neutral-900">
                  <td class="border-r border-neutral-900 p-5 align-top min-h-[120px]">
                    <p class="font-semibold">${data.description}</p>
                    <p class="text-xs text-neutral-600 mt-1 italic">Terbilang: ${data.terbilang}</p>
                  </td>
                  <td class="p-5 text-right font-bold align-top">${data.amountFormatted}</td>
                </tr>
                <tr>
                  <td class="border-r border-neutral-900 p-3 text-center font-semibold">Total</td>
                  <td class="p-3 text-right font-bold">${data.amountFormatted}</td>
                </tr>
              </tbody>
            </table>

            <div class="text-center text-3xl font-bold text-neutral-200 tracking-wide select-none py-2">PrangArt Lab</div>

            <div class="flex flex-col items-end pt-4 space-y-4">
              <p class="font-semibold">${appState.settings.directorName}</p>
              <p class="italic text-2xl font-serif">Terima kasih!</p>
            </div>
          </div>
        `;
      } else {
        canvasEl.innerHTML = `
          <div class="font-serif text-neutral-900 space-y-6 p-2">
            <div class="flex flex-wrap items-center justify-between gap-4 border-b-2 border-neutral-900 pb-4">
              <div class="flex items-center gap-3">
                <img src="${LOGO_URL}" alt="PrangArt Lab" class="w-16 h-16 object-contain" />
                <div>
                  <h2 class="text-2xl font-bold leading-none">PrangArt Lab</h2>
                  <p class="text-xs font-bold mt-1">Home Music Production Studio</p>
                  <p class="text-[11px]">Email: ${appState.settings.studioEmail} &nbsp; WhatsApp: 08977230597</p>
                </div>
              </div>
              <h1 class="text-4xl font-normal">Kuitansi</h1>
            </div>

            <div class="space-y-4 text-sm">
              <div class="flex gap-4">
                <span class="w-40 font-bold">Nomor:</span>
                <span class="font-mono font-bold">${data.docNumber}</span>
              </div>
              <div class="flex gap-4">
                <span class="w-40 font-bold">Sudah terima dari:</span>
                <span class="flex-1 border-b border-neutral-800 pb-1 font-semibold">${data.proj.clientName} — ${data.proj.instansi}</span>
              </div>
              <div class="flex gap-4">
                <span class="w-40 font-bold">Banyaknya uang:</span>
                <span class="flex-1 border-b border-neutral-800 pb-1 italic font-semibold">${data.terbilang}</span>
              </div>
              <div class="flex gap-4">
                <span class="w-40 font-bold">Untuk pembayaran:</span>
                <span class="flex-1 border-b border-neutral-800 pb-1">${data.description}</span>
              </div>
            </div>

            <div class="flex flex-wrap items-end justify-between gap-6 pt-6">
              <div class="bg-neutral-200 px-6 py-3 font-bold text-lg border border-neutral-400">
                ${data.amountFormatted}
              </div>
              <div class="text-center space-y-14">
                <div>
                  <p class="font-bold">Samarinda, ${data.dateText}</p>
                  <p class="text-xs">Penerima,</p>
                </div>
                <p class="font-bold border-t border-neutral-900 pt-1 px-4">${appState.settings.directorName}</p>
              </div>
            </div>
          </div>
        `;
      }
    }

    async function downloadOfficialDocPNG() {
      const data = getOfficialDocComputedData();
      if (!data) return;
      const c = document.createElement('canvas');
      c.width = 1240;
      c.height = data.docType === 'invoice' ? 1650 : 760;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);

      const logoImg = await loadImageElement(LOGO_URL);
      ctx.fillStyle = '#171717';

      if (data.docType === 'invoice') {
        if (logoImg) ctx.drawImage(logoImg, 90, 70, 110, 110);
        ctx.font = 'bold 20px Georgia, serif';
        ctx.textAlign = 'center';
        ctx.fillText('PrangArt Lab', 145, 205);

        ctx.font = '72px Georgia, serif';
        ctx.textAlign = 'right';
        ctx.fillText('Invoice', 1140, 155);

        ctx.textAlign = 'left';
        ctx.font = '21px Georgia, serif';
        ctx.fillText('Jl. Wiraguna Gang 4', 90, 275);
        ctx.fillText('Kel. Sidodadi, Samarinda', 90, 305);
        ctx.font = '18px Georgia, serif';
        ctx.fillText(`Email : ${appState.settings.studioEmail}`, 90, 335);
        ctx.fillText('WhatsApp: 08977230597', 90, 362);

        ctx.textAlign = 'right';
        ctx.font = '21px Georgia, serif';
        ctx.fillText(`No: ${data.docNumber}`, 1140, 275);
        ctx.fillText(`Tanggal: ${data.dateText}`, 1140, 305);
        ctx.fillText(`Nama: ${data.proj.clientName}`, 1140, 335);

        ctx.strokeStyle = '#171717';
        ctx.lineWidth = 2;
        ctx.strokeRect(90, 420, 1050, 420);
        ctx.beginPath(); ctx.moveTo(90, 485); ctx.lineTo(1140, 485); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(90, 770); ctx.lineTo(1140, 770); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(760, 420); ctx.lineTo(760, 840); ctx.stroke();

        ctx.textAlign = 'center';
        ctx.font = '22px Georgia, serif';
        ctx.fillText('Deskripsi', 425, 460);
        ctx.font = 'bold 22px Georgia, serif';
        ctx.fillText('Jumlah', 950, 460);

        ctx.textAlign = 'left';
        ctx.font = '20px Georgia, serif';
        wrapCanvasText(ctx, data.description, 630).forEach((line, idx) => {
          ctx.fillText(line, 115, 535 + idx * 30);
        });
        ctx.font = 'italic 18px Georgia, serif';
        wrapCanvasText(ctx, `Terbilang: ${data.terbilang}`, 630).forEach((line, idx) => {
          ctx.fillText(line, 115, 655 + idx * 26);
        });

        ctx.textAlign = 'right';
        ctx.font = 'bold 22px Georgia, serif';
        ctx.fillText(data.amountFormatted, 1115, 535);
        ctx.fillText(data.amountFormatted, 1115, 813);

        ctx.textAlign = 'center';
        ctx.font = '22px Georgia, serif';
        ctx.fillText('Total', 425, 813);

        ctx.fillStyle = '#e5e5e5';
        ctx.font = 'bold 64px Georgia, serif';
        ctx.fillText('PrangArt Lab', 620, 990);

        ctx.fillStyle = '#171717';
        ctx.textAlign = 'right';
        ctx.font = '22px Georgia, serif';
        ctx.fillText(appState.settings.directorName, 1140, 1160);
        ctx.font = 'italic 44px Georgia, serif';
        ctx.fillText('Terima kasih!', 1140, 1265);
      } else {
        if (logoImg) ctx.drawImage(logoImg, 70, 45, 95, 95);
        ctx.textAlign = 'left';
        ctx.font = 'bold 42px Georgia, serif';
        ctx.fillText('PrangArt Lab', 180, 92);
        ctx.font = 'bold 18px Georgia, serif';
        ctx.fillText('Home Music Production Studio', 182, 120);
        ctx.font = '15px Georgia, serif';
        ctx.fillText(`Email: ${appState.settings.studioEmail}   WhatsApp: 08977230597`, 182, 144);

        ctx.textAlign = 'right';
        ctx.font = '56px Georgia, serif';
        ctx.fillText('Kuitansi', 1170, 125);

        ctx.strokeStyle = '#171717';
        ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(70, 165); ctx.lineTo(1170, 165); ctx.stroke();

        ctx.textAlign = 'left';
        ctx.font = 'bold 21px Georgia, serif';
        ctx.fillText(`Nomor:  ${data.docNumber}`, 70, 225);

        const drawFieldRow = (label, val, y) => {
          ctx.font = 'bold 21px Georgia, serif';
          ctx.fillText(label, 70, y);
          ctx.font = '20px Georgia, serif';
          ctx.fillText(val, 310, y, 840);
          ctx.beginPath(); ctx.moveTo(300, y + 10); ctx.lineTo(1170, y + 10); ctx.stroke();
        };

        drawFieldRow('Sudah terima dari:', `${data.proj.clientName} — ${data.proj.instansi}`, 300);
        drawFieldRow('Banyaknya uang:', data.terbilang, 375);
        drawFieldRow('Untuk pembayaran:', data.description, 450);

        ctx.fillStyle = '#d4d4d4';
        ctx.fillRect(300, 525, 290, 62);
        ctx.fillStyle = '#171717';
        ctx.font = 'bold 24px Georgia, serif';
        ctx.fillText(data.amountFormatted, 320, 565);

        ctx.textAlign = 'center';
        ctx.font = 'bold 20px Georgia, serif';
        ctx.fillText(`Samarinda, ${data.dateText}`, 1010, 515);
        ctx.font = '18px Georgia, serif';
        ctx.fillText('Penerima,', 1010, 542);
        ctx.beginPath(); ctx.moveTo(880, 655); ctx.lineTo(1140, 655); ctx.stroke();
        ctx.font = 'bold 20px Georgia, serif';
        ctx.fillText(appState.settings.directorName, 1010, 685);
      }

      triggerPngFileDownload(c.toDataURL('image/png'), `${data.docType.toUpperCase()}-PrangArt-${data.proj.id}.png`);
      showToast('Dokumen Diunduh', `${data.docType === 'invoice' ? 'Invoice' : 'Kuitansi'} PNG siap dikirim ke konsumen.`);
    }

    // -------------------------------------------------------------------------
    // OFFICIAL CONTRACT / SERVICE APPROVAL DOCUMENT (TAHAP 7)
    // -------------------------------------------------------------------------
    let activeContractDocData = null;

    function buildContractDataFromProject(proj) {
      const dpNominal = proj.dpAmount || Math.round((proj.totalPrice || 0) * 0.5);
      const pelunasanNominal = (proj.totalPrice || 0) - dpNominal;
      return {
        tanggal: proj.createdAt || new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        nama: proj.clientName || '........................................',
        sanggar: proj.instansi || '........................................',
        namaTari: proj.judul || '........................................',
        estimasi: proj.durasi || '.... : ....',
        jumlahFormatted: Number(proj.totalPrice || 0).toLocaleString('id-ID') + ',00',
        jumlahTerbilang: `${numberToIndonesianWords(proj.totalPrice || 0)} Rupiah`,
        dpFormatted: formatRupiah(dpNominal),
        pelunasanFormatted: formatRupiah(pelunasanNominal),
        paketLabel: proj.packageName || 'Paket Pilihan',
        serviceLine: proj.serviceLine || 'tari',
        serviceLineLabel: proj.serviceLineLabel || 'Produksi Musik Tari',
        buyoutSelected: Boolean(proj.buyoutSelected),
        ticketId: proj.id || 'DRAFT'
      };
    }

    function openDraftContractPreviewModal() {
      const u = appState.currentClientUser || {};
      const svc = appState.serviceCatalog[appState.selectedServiceLine];
      const pkg = svc.packages[appState.selectedPackage];
      const addonChecked = Boolean(document.getElementById('field-addon-vocal')?.checked);
      const buyoutChecked = Boolean(document.getElementById('field-addon-buyout')?.checked);
      const total = pkg.price + (addonChecked ? svc.addonPrice : 0) + (buyoutChecked ? 1000000 : 0);

      const draftProj = {
        id: 'DRAFT',
        createdAt: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }),
        clientName: document.getElementById('field-nama')?.value.trim() || u.name || '........................................',
        instansi: document.getElementById('field-instansi')?.value.trim() || u.instansi || '........................................',
        judul: document.getElementById('field-judul')?.value.trim() || '........................................',
        durasi: document.getElementById('field-durasi')?.value.trim() || '05:00',
        totalPrice: total,
        dpAmount: Math.round(total * 0.5),
        packageName: pkg.label,
        serviceLine: appState.selectedServiceLine,
        serviceLineLabel: svc.label,
        buyoutSelected: buyoutChecked
      };
      activeContractDocData = buildContractDataFromProject(draftProj);
      renderContractDocumentCanvas();
      document.getElementById('contract-sign-footer')?.classList.add('hidden');
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function openContractDocModal(projId, enableSigning = false) {
      const proj = appState.projects.find(p => p.id === projId);
      if (!proj) return;
      activeContractDocData = buildContractDataFromProject(proj);
      renderContractDocumentCanvas();
      const footer = document.getElementById('contract-sign-footer');
      const cb = document.getElementById('sign-agreement-cb');
      if (cb) cb.checked = false;
      if (footer) {
        if (enableSigning && !proj.agreementSigned) {
          footer.classList.remove('hidden');
          footer.classList.add('flex');
        } else {
          footer.classList.add('hidden');
          footer.classList.remove('flex');
        }
      }
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    }

    function closeContractDocModal() {
      const modal = document.getElementById('contract-doc-modal');
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
    }

    async function confirmClientAdministrativeApproval() {
      const cb = document.getElementById('sign-agreement-cb');
      if (!cb?.checked) {
        showToast('Centang Persetujuan', 'Centang kotak persetujuan terlebih dahulu.', 'warning');
        return;
      }
      const proj = appState.projects.find(p => p.id === activeContractDocData?.ticketId);
      if (!proj) return;
      proj.agreementSigned = true;
      proj.agreementSignedAt = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      proj.productionStatus = TRACKER_MILESTONES[3];
      await syncProjectToCloud(proj);
      closeContractDocModal();
      renderClientWorkspace();
      showToast('Administrasi Disetujui', 'Tahap pembayaran telah dibuka untuk pesanan Anda.');
    }

    function renderContractDocumentCanvas() {
      const d = activeContractDocData;
      const canvasEl = document.getElementById('contract-doc-canvas');
      const headingEl = document.getElementById('contract-modal-heading');
      if (!d || !canvasEl) return;

      const isTranskripsi = d.serviceLine === 'transkripsi';
      const docMainTitle = isTranskripsi
        ? 'PERSETUJUAN PENAWARAN & KETENTUAN TRANSKRIPSI MUSIK'
        : d.serviceLine === 'digital'
          ? 'PERJANJIAN PRODUKSI MUSIK NON-TARI'
          : 'PERJANJIAN PRODUKSI MUSIK TARI';

      if (headingEl) headingEl.textContent = `${docMainTitle} — PrangArt Lab`;

      canvasEl.innerHTML = `
        <div class="space-y-5 text-neutral-900">
          <div class="flex items-center justify-between border-b-2 border-neutral-900 pb-4">
            <div class="flex items-center gap-3">
              <img src="${LOGO_URL}" alt="PrangArt Lab" class="w-14 h-14 object-contain" />
              <div>
                <h2 class="text-lg sm:text-xl font-bold tracking-tight uppercase">${docMainTitle}</h2>
                <p class="text-xs font-semibold text-neutral-700">PrangArt Lab • PrangArt Studios (${d.ticketId})</p>
              </div>
            </div>
            <div class="text-right text-xs">
              <p class="font-bold">Tanggal:</p>
              <p>${d.tanggal}</p>
            </div>
          </div>

          <p>Dokumen ini dibuat dan disetujui pada tanggal tersebut di atas, oleh dan antara:</p>

          <table class="w-full text-xs sm:text-sm border-collapse">
            <tbody>
              <tr>
                <td class="py-1 w-6 font-bold align-top">1.</td>
                <td class="py-1 w-56">Nama</td>
                <td class="py-1 w-4">:</td>
                <td class="py-1 font-bold">${appState.settings.directorName}</td>
              </tr>
              <tr>
                <td></td>
                <td class="py-1">Jabatan</td>
                <td class="py-1">:</td>
                <td class="py-1">Komposer / Pemilik PrangArt Lab</td>
              </tr>
              <tr>
                <td></td>
                <td colspan="3" class="pb-2 italic">(Selanjutnya disebut sebagai <strong>"PIHAK PERTAMA"</strong>).</td>
              </tr>
              <tr>
                <td class="py-1 font-bold align-top">2.</td>
                <td class="py-1">Nama</td>
                <td class="py-1">:</td>
                <td class="py-1 font-bold">${d.nama}</td>
              </tr>
              <tr>
                <td class="py-1 font-bold align-top">3.</td>
                <td class="py-1">Instansi/Sanggar/Komunitas/Individu</td>
                <td class="py-1">:</td>
                <td class="py-1 font-semibold">${d.sanggar}</td>
              </tr>
              <tr>
                <td class="py-1 font-bold align-top">4.</td>
                <td class="py-1">Jabatan</td>
                <td class="py-1">:</td>
                <td class="py-1">Pemesan Layanan (${d.serviceLineLabel})</td>
              </tr>
              <tr>
                <td></td>
                <td colspan="3" class="italic">(Selanjutnya disebut sebagai <strong>"PIHAK KEDUA"</strong>).</td>
              </tr>
            </tbody>
          </table>

          <div class="space-y-4">
            <div>
              <h4 class="font-bold text-center uppercase">PASAL 1 — RUANG LINGKUP DAN OBJEK KERJA</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK PERTAMA bertanggung jawab penuh atas proses pengerjaan ${d.serviceLineLabel} sesuai ruang lingkup yang telah didiskusikan dan disepakati.</li>
                <li>Objek karya ini diperuntukkan bagi karya berjudul <strong>"${d.namaTari}"</strong> dengan durasi estimasi <strong>${d.estimasi}</strong> menit.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 2 — NILAI KONTRAK DAN KETENTUAN PEMBAYARAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Total biaya yang disepakati adalah sebesar <strong>Rp${d.jumlahFormatted}</strong> (<em>${d.jumlahTerbilang}</em>).</li>
                <li>Pembayaran dilakukan dengan skema DP 50% (<strong>${d.dpFormatted}</strong>) sebelum pengerjaan dimulai dan pelunasan 50% (<strong>${d.pelunasanFormatted}</strong>) sebelum penyerahan berkas kualitas tinggi, atau pembayaran penuh 100% di awal.</li>
                <li>Seluruh biaya yang telah dibayarkan bersifat <em>non-refundable</em> apabila pembatalan dilakukan secara sepihak oleh PIHAK KEDUA.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 3 — HAK PORTOFOLIO DAN HAK MORAL</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li><strong>Hak Moral:</strong> PIHAK PERTAMA selamanya memegang Hak Moral atas karya tersebut. PIHAK KEDUA wajib mencantumkan nama <strong>${appState.settings.directorName}</strong> sebagai Komposer/Transkriptor dalam materi publikasi.</li>
                <li><strong>Hak Portofolio:</strong> PIHAK PERTAMA berhak menggunakan potongan karya maksimal 1 menit sebagai materi portofolio resmi PrangArt Lab dengan mencantumkan nama karya, sanggar/instansi, dan kreator.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 4 — LISENSI DAN EKSKLUSIVITAS PENGGUNAAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK KEDUA menerima Lisensi Eksklusif untuk pementasan, perlombaan, pendidikan, dan dokumentasi visual pada media sosial.</li>
                <li>PIHAK PERTAMA menjamin karya tidak akan dialihkan atau dijual kembali kepada pihak lain untuk karya berbeda.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 5 — PENGALIHAN HAK EKONOMI (BUYOUT) &amp; KLAIM HAK CIPTA</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>PIHAK KEDUA dilarang mendaftarkan karya ke LMK, melakukan <em>Content ID Claim</em>, atau mendistribusikan audio secara komersial mandiri tanpa persetujuan tertulis dari PIHAK PERTAMA.</li>
                <li>Biaya Tambahan Pengalihan Hak Ekonomi (<em>Buyout Fee</em>) sebesar <strong>Rp1.000.000,00 (Satu Juta Rupiah)</strong> berlaku apabila PIHAK KEDUA mengklaim hak ekonomi penuh atas nama Sanggar/Instansi, disertai penerbitan Surat Pengalihan Hak Ekonomi. ${d.buyoutSelected ? '<span class="px-2 py-0.5 bg-emerald-100 text-emerald-900 font-bold rounded">[AKTIF]</span>' : ''}</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 6 — REVISI DAN PERUBAHAN</h4>
              <ol class="list-decimal pl-5 space-y-1 mt-1">
                <li>Kuota revisi: Paket Dasar (3x revisi ringan), Paket Standar (6x revisi), Paket Pro (bebas revisi selama tidak mengubah konsep dasar awal).</li>
                <li>Perubahan sebanyak 65% dari total kumulasi durasi dan/atau konsep secara total setelah proses berjalan dikenakan biaya tambahan sesuai eskalasi pekerjaan.</li>
              </ol>
            </div>

            <div>
              <h4 class="font-bold text-center uppercase">PASAL 7 — PENYELESAIAN PERSELISIHAN</h4>
              <p class="mt-1">Segala perselisihan diselesaikan secara musyawarah untuk mufakat, atau menempuh jalur hukum sesuai domisili hukum PIHAK PERTAMA.</p>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-8 pt-8 text-center">
            <div class="space-y-14">
              <div>
                <p class="font-bold">PIHAK PERTAMA</p>
                <p class="text-xs text-neutral-600">PrangArt Lab • PrangArt Studios</p>
              </div>
              <p class="font-bold underline">${appState.settings.directorName}</p>
            </div>
            <div class="space-y-14">
              <div>
                <p class="font-bold">PIHAK KEDUA</p>
                <p class="text-xs text-neutral-600">Klien / Pemesan Layanan</p>
              </div>
              <p class="font-bold underline">${d.nama}</p>
            </div>
          </div>
        </div>
      `;
    }

    function downloadContractDocPNG() {
      const d = activeContractDocData;
      if (!d) return;
      const c = document.createElement('canvas');
      c.width = 1240;
      c.height = 1754;
      const ctx = c.getContext('2d');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);
      ctx.fillStyle = '#171717';

      ctx.font = 'bold 26px Georgia, serif';
      ctx.textAlign = 'center';
      ctx.fillText(`PERJANJIAN / PERSETUJUAN ${d.serviceLineLabel.toUpperCase()}`, 620, 85);
      ctx.font = 'bold 20px Georgia, serif';
      ctx.fillText(`PrangArt Lab • PrangArt Studios (${d.ticketId})`, 620, 118);

      ctx.beginPath(); ctx.moveTo(80, 142); ctx.lineTo(1160, 142); ctx.stroke();

      ctx.textAlign = 'left';
      ctx.font = '17px Georgia, serif';
      let y = 178;
      const lh = 25;

      const writeLine = (txt, bold = false) => {
        ctx.font = `${bold ? 'bold ' : ''}17px Georgia, serif`;
        wrapCanvasText(ctx, txt, 1080).forEach(line => {
          ctx.fillText(line, 80, y);
          y += lh;
        });
      };

      writeLine(`Tanggal: ${d.tanggal}`, true);
      writeLine(`PIHAK PERTAMA: ${appState.settings.directorName} (Komposer / Pemilik PrangArt Lab)`, true);
      writeLine(`PIHAK KEDUA: ${d.nama} — ${d.sanggar} (Pemesan ${d.serviceLineLabel})`, true);
      y += 8;
      writeLine(`PASAL 1 (Ruang Lingkup): Pengerjaan ${d.serviceLineLabel} untuk karya "${d.namaTari}" (estimasi ${d.estimasi} menit).`);
      y += 6;
      writeLine(`PASAL 2 (Nilai Kontrak): Total biaya Rp${d.jumlahFormatted} (${d.jumlahTerbilang}). Skema DP 50% (${d.dpFormatted}) & Pelunasan 50% (${d.pelunasanFormatted}), atau Penuh 100%. Pembatalan sepihak bersifat non-refundable.`);
      y += 6;
      writeLine(`PASAL 3 (Hak Moral & Portofolio): Hak Moral selamanya milik PIHAK PERTAMA; wajib mencantumkan nama ${appState.settings.directorName}. PIHAK PERTAMA berhak memakai potongan karya maks. 1 menit untuk portofolio.`);
      y += 6;
      writeLine(`PASAL 4 (Lisensi Eksklusif): Lisensi terbatas untuk pementasan, perlombaan, dan dokumentasi media sosial.`);
      y += 6;
      writeLine(`PASAL 5 (Buyout & Hak Cipta): Dilarang mendaftarkan ke LMK / Content ID Claim tanpa izin tertulis. Biaya Pengalihan Hak Ekonomi (Buyout Fee) sebesar Rp1.000.000,00 (${d.buyoutSelected ? 'AKTIF' : 'Opsional'}).`);
      y += 6;
      writeLine(`PASAL 6 (Revisi): Paket Dasar 3x revisi ringan; Paket Standar 6x revisi; Paket Pro bebas revisi sesuai konsep awal. Perubahan >65% durasi/konsep dikenakan biaya tambahan.`);
      y += 6;
      writeLine(`PASAL 7 & PENUTUP: Penyelesaian perselisihan secara musyawarah atau domisili hukum PIHAK PERTAMA.`);

      const sigY = Math.max(y + 60, 1460);
      ctx.textAlign = 'center';
      ctx.font = 'bold 18px Georgia, serif';
      ctx.fillText('PIHAK PERTAMA', 320, sigY);
      ctx.fillText('PrangArt Lab', 320, sigY + 26);
      ctx.fillText(appState.settings.directorName, 320, sigY + 145);

      ctx.fillText('PIHAK KEDUA', 920, sigY);
      ctx.fillText('Klien / Pemesan', 920, sigY + 26);
      ctx.fillText(d.nama, 920, sigY + 145);

      triggerPngFileDownload(c.toDataURL('image/png'), `Perjanjian-PrangArt-${d.ticketId}.png`);
      showToast('Dokumen Diunduh', 'Dokumen perjanjian PNG siap dikirim/ditandatangani.', 'success');
    }

    // -------------------------------------------------------------------------
    // PORTFOLIO, FAQ & SAMPLE SYNTH PLAYER
    // -------------------------------------------------------------------------
    function filterPortfolio(cat) {
      appState.portfolioFilter = cat;
      document.querySelectorAll('.pf-filter-btn').forEach(btn => {
        if (btn.textContent.trim() === cat) {
          btn.className = 'pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-bold bg-gold text-obsidian';
        } else {
          btn.className = 'pf-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-charcoal text-ash border border-borderline';
        }
      });
      renderPortfolioGrid();
    }

    function renderPortfolioGrid() {
      const grid = document.getElementById('portfolio-grid');
      if (!grid) return;
      const list = appState.portfolioFilter === 'Semua'
        ? appState.portfolioItems
        : appState.portfolioItems.filter(i => i.category === appState.portfolioFilter);

      grid.innerHTML = list.map(item => `
        <div class="bg-charcoal border border-borderline hover:border-gold/40 rounded-2xl p-5 flex flex-col justify-between space-y-4 transition">
          <div class="space-y-2">
            <div class="flex items-center justify-between text-[11px] font-mono">
              <span class="text-gold font-bold">${item.category}</span>
              <span class="text-ash">${item.duration}</span>
            </div>
            <h3 class="text-base font-bold text-ivory">${item.title}</h3>
            <span class="text-[11px] text-emerald-400 block">${item.culture}</span>
            <p class="text-xs text-ash leading-relaxed">${item.desc}</p>
          </div>
          <div class="flex items-center gap-2 pt-2 border-t border-borderline">
            <button type="button" onclick="playSampleTone(${item.freq || 220}, '${item.title}')" class="btn-ghost-gold flex-1 py-2 rounded-xl text-xs font-bold">▶ Sampel Audio</button>
            <button type="button" onclick="openProducerWaModal('Saya tertarik diskusi karya serupa: ${item.title}', '${item.category}')" class="btn-gold px-3.5 py-2 rounded-xl text-xs font-bold">Diskusi WA</button>
          </div>
        </div>
      `).join('');
    }

    function playSampleTone(baseFreq, title) {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioCtx();
        const notes = [baseFreq, baseFreq * 1.25, baseFreq * 1.5, baseFreq * 1.875];
        notes.forEach((f, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(f, ctx.currentTime + idx * 0.25);
          gain.gain.setValueAtTime(0.08, ctx.currentTime + idx * 0.25);
          gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + idx * 0.25 + 0.6);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(ctx.currentTime + idx * 0.25);
          osc.stop(ctx.currentTime + idx * 0.25 + 0.65);
        });
        showToast('Memutar Sampel', `Cuplikan melodi: ${title}`);
      } catch (_) {}
    }

    function renderFaqAccordion() {
      const list = document.getElementById('faq-accordion-list');
      if (!list) return;
      list.innerHTML = appState.faqs.map((f, idx) => `
        <div class="bg-charcoal border border-borderline rounded-xl overflow-hidden">
          <button type="button" onclick="toggleFaqItem(${idx})" class="w-full px-4 py-3.5 text-left flex items-center justify-between gap-3 text-xs sm:text-sm font-bold text-ivory hover:text-gold transition">
            <span>${f.q}</span>
            <span id="faq-icon-${idx}" class="text-gold font-mono">+</span>
          </button>
          <div id="faq-body-${idx}" class="hidden px-4 pb-4 text-xs text-ash leading-relaxed border-t border-borderline/60 pt-3">
            ${f.a}
          </div>
        </div>
      `).join('');
    }

    function toggleFaqItem(idx) {
      const body = document.getElementById(`faq-body-${idx}`);
      const icon = document.getElementById(`faq-icon-${idx}`);
      if (!body) return;
      const isHidden = body.classList.contains('hidden');
      body.classList.toggle('hidden');
      if (icon) icon.textContent = isHidden ? '−' : '+';
    }

    // Expose all handlers globally
    Object.assign(window, {
      appState,
      navigateTo,
      selectServiceAndGoOrder,
      closeWelcomeModal,
      openProducerWaModal,
      closeProducerWaModal,
      updateWaComposerPreview,
      submitProducerWaMessage,
      openClientAuthModal,
      closeClientAuthModal,
      switchAuthModalTab,
      handleQuickClientRegister,
      handleQuickClientLogin,
      logoutClientUser,
      selectServiceLine,
      selectPackageTier,
      addBasicInstrument,
      removeBasicInstrument,
      toggleStandarStructCard,
      addProSceneBlock,
      removeProSceneBlock,
      recalculateLivePrice,
      copyBankAccount,
      generateAISynopsis,
      restorePreviousSynopsis,
      handleOrderFormSubmit,
      downloadCurrentBriefPNG,
      sendBriefCardToProducerWA,
      openBriefCardModal,
      closeBriefCardModal,
      handleClientPortalLogin,
      renderClientWorkspace,
      changeClientPaymentScheme,
      uploadClientStagePayment,
      confirmClientFinalReceipt,
      downloadMasterAsset,
      launchWhatsAppProjectDiscussion,
      verifyAdminPin,
      renderAdminDashboard,
      issueOfficialQuotation,
      updateAdminProjectStage,
      verifyProjectPayment,
      inspectPaymentProof,
      closeCustomModal,
      uploadStudioDeliverable,
      saveStudioSettings,
      addPortfolioItem,
      removePortfolioItem,
      openOfficialDocModal,
      closeOfficialDocModal,
      switchOfficialDocType,
      switchOfficialDocStage,
      downloadOfficialDocPNG,
      openDraftContractPreviewModal,
      openContractDocModal,
      closeContractDocModal,
      confirmClientAdministrativeApproval,
      downloadContractDocPNG,
      filterPortfolio,
      playSampleTone,
      toggleFaqItem
    });

    // Boot Application
    updateHeaderAuthBadge();
    renderSop14Grid();
    renderFaqAccordion();
    renderPortfolioGrid();
    navigateTo('home');
    initFirebaseSync();

    setTimeout(() => {
      const wm = document.getElementById('welcome-modal');
      wm?.classList.remove('hidden');
      wm?.classList.add('flex');
    }, 350);
  </script>
</body>
</html>
```